in_pin:none
out_pin:none
options:no_meter

@init
// ----- slider numbers -----
NSG = 12;  NCG = 11;
SB = 3;  CSB = 15;  CGRP = 27;  HB = 28;  CHB = 39;
S_DR2 = 51;  S_DR3 = 52;  S_DR4 = 53;
S_TW = 54;  S_DBL = 55;  S_HV = 56;  S_LO = 57;  S_HI = 58;

// ----- memory map -----
SC = 0;        // scale steps, ascending (relative to root)
SCP = 16;      // scale pitch classes (root applied)
SHP = 32;      // base shape pitch classes (root applied)
VOICES = 48;   // harmonized voices (melody first)
OUT = 64;      // final chord notes
DRF = 80;      // drop flags, index 1..3
LS = 1000;     // scale library (12-bit masks)
LH = 2000;     // base shape library (12-bit masks)
GSS = 2200;    // first library index of each scale group
GSC = 2260;    // first library index of each shape group
CNT = 4000;    // [ch*128+note] number of chord notes sounding for that input note
REFC = 6100;   // [ch*128+pitch] reference count of output notes
STORE = 9000;  // [(ch*128+note)*8+slot] output pitches of each held input note

// string handles (named strings are not directly accessible inside functions)
NMS = #nm;  CHS = #chordstr;
memset(CNT, 0, 2048);
memset(REFC, 0, 2048);

// ---------------------------------------------------------------------------
// music theory core (same maths as the web tool)
// ---------------------------------------------------------------------------
function mod12(n) ( n - 12 * floor(n / 12); );

// index of pitch class pc inside the scale, or -1
function scale_idx(pc) local(i, r) global(SCP, scN) (
  r = -1; i = 0;
  while (i < scN) (
    SCP[i] == pc ? ( r = i; i = scN; );
    i += 1;
  );
  r;
);

function in_shape(pc) local(i, r) global(SHP, shN) (
  r = 0; i = 0;
  while (i < shN) (
    SHP[i] == pc ? ( r = 1; );
    i += 1;
  );
  r;
);

function pos_note(pos) local(o, d) global(scN, scRoot, SC) (
  o = floor(pos / scN);
  d = pos - scN * o;
  scRoot + o * 12 + SC[d];
);

// move a scale note by `count` scale steps; -9999 if the note is not in the scale
function step_scale(note, count) local(idx, pos) global(scN, scRoot) (
  idx = scale_idx(mod12(note));
  idx < 0 ? -9999 : (
    pos = floor((note - scRoot) / 12) * scN + idx;
    pos_note(pos + count);
  );
);

// base-shape inversion with `mnote` on top. Fills VOICES, returns voice count or -1
function harm_shape(mnote, vc) local(mpc, idx, i, k, pc, cand, prev, cnt, res) global(SHP, shN, VOICES) (
  mpc = mod12(mnote);
  idx = -1; i = 0;
  while (i < shN) (
    SHP[i] == mpc && idx < 0 ? ( idx = i; );
    i += 1;
  );
  res = -1;
  idx >= 0 ? (
    VOICES[0] = mnote; cnt = 1; prev = mnote; i = 1;
    while (i < vc && i < shN) (
      k = idx - i;
      k = k - shN * floor(k / shN);
      pc = SHP[k];
      cand = prev - 1;
      while (mod12(cand) != pc) ( cand -= 1; 1; );
      VOICES[cnt] = cand; cnt += 1; prev = cand;
      i += 1;
    );
    res = cnt;
  );
  res;
);

// Harmonize one melody note. Result in OUT[0..outN-1] (OUT[0] is the melody).
function harmonize(note) local(mpc, alt, ref, dist, found, d1, d2, vn, cur, nxt, i, j, orig) global(OUT, VOICES, DRF, outN, TWHOLE, DBLON, scN, shN) (
  mpc = mod12(note);
  alt = 0; ref = note;

  // out-of-scale and out-of-shape: alteration of the nearest in-scale pitch class
  (in_shape(mpc) == 0 && scale_idx(mpc) < 0) ? (
    dist = 1; found = 0;
    while (dist <= 6 && found == 0) (
      d1 = scale_idx(mod12(mpc - dist)) >= 0;
      d2 = scale_idx(mod12(mpc + dist)) >= 0;
      d1 ? ( alt = dist; found = 1; ) : ( d2 ? ( alt = -dist; found = 1; ); );
      dist += 1;
    );
    ref = note - alt;
  );

  vn = harm_shape(ref, 4);
  vn < 0 ? (
    // descending thirds along the scale
    VOICES[0] = ref; vn = 1; cur = ref; i = 0;
    while (i < 3) (
      nxt = step_scale(cur, -2);
      nxt < -1000 ? ( i = 99; ) : (
        mod12(nxt - ref) == 6 ? ( nxt = step_scale(nxt, 1); );
        VOICES[vn] = nxt; vn += 1; cur = nxt;
      );
      i += 1;
    );
  );

  alt != 0 ? (
    TWHOLE ? (
      j = 0;
      while (j < vn) ( VOICES[j] += alt; j += 1; );
    ) : (
      VOICES[0] = note;
    );
  );

  // assemble the final chord, with optional drops
  OUT[0] = VOICES[0]; outN = 1;
  vn >= 4 ? (
    i = 1;
    while (i <= 3) ( DRF[i] == 0 ? ( OUT[outN] = VOICES[i]; outN += 1; ); i += 1; );
    DBLON ? ( OUT[outN] = note - 12; outN += 1; );
    i = 1;
    while (i <= 3) ( DRF[i] != 0 ? ( OUT[outN] = VOICES[i] - 12; outN += 1; ); i += 1; );
  ) : (
    i = 1;
    while (i < vn) ( OUT[outN] = VOICES[i]; outN += 1; i += 1; );
    DBLON ? ( OUT[outN] = note - 12; outN += 1; );
  );
  outN;
);

// ---------------------------------------------------------------------------
// MIDI helpers (reference-counted so overlapping chords never cut each other)
// ---------------------------------------------------------------------------
function play_note(ch, p, v, offs) local(k) global(REFC) (
  k = ch * 128 + p;
  REFC[k] > 0 ? ( midisend(offs, 0x80 | ch, p, 0); );
  REFC[k] += 1;
  midisend(offs, 0x90 | ch, p, v);
);

function stop_note(ch, p, ov, offs) local(k) global(REFC) (
  k = ch * 128 + p;
  REFC[k] > 0 ? (
    REFC[k] -= 1;
    REFC[k] == 0 ? ( midisend(offs, 0x80 | ch, p, ov); );
  );
);

function chord_off(ch, note, ov, offs) local(key, j) global(CNT, STORE) (
  key = ch * 128 + note;
  j = 0;
  while (j < CNT[key]) (
    stop_note(ch, STORE[key * 8 + j], ov, offs);
    j += 1;
  );
  CNT[key] = 0;
);

function pc_name(dest, pc) global(NMS) (
  sprintf(NMS, "%c", str_getchar("CCDDEFFGGAAB", pc));
  strcat(dest, NMS);
  str_getchar("010100101010", pc) == '1' ? ( strcat(dest, "#"); );
);

function note_name(dest, midi) global(NMS) (
  pc_name(dest, mod12(midi));
  sprintf(NMS, "%d", floor(midi / 12) - 1);
  strcat(dest, NMS);
);

function chord_on(ch, note, vel, offs) local(key, j, p, v, s, dup) global(CNT, STORE, OUT, outN, HVEL, CHS) (
  key = ch * 128 + note;
  CNT[key] > 0 ? ( chord_off(ch, note, 64, offs); );
  harmonize(note);
  CNT[key] = 0;
  strcpy(CHS, "Last chord:");
  j = 0;
  while (j < outN) (
    p = OUT[j];
    dup = 0; s = 0;
    while (s < CNT[key]) ( STORE[key * 8 + s] == p ? ( dup = 1; ); s += 1; );
    (dup == 0 && p >= 0 && p <= 127 && CNT[key] < 8) ? (
      v = j == 0 ? vel : max(1, min(127, floor(vel * HVEL / 100 + 0.5)));
      play_note(ch, p, v, offs);
      STORE[key * 8 + CNT[key]] = p;
      CNT[key] += 1;
      strcat(CHS, " ");
      note_name(CHS, p);
    );
    j += 1;
  );
);

// ---------------------------------------------------------------------------
// library loading
// ---------------------------------------------------------------------------
