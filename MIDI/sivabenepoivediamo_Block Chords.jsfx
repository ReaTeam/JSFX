GSS[0]=0; GSS[1]=21; GSS[2]=59; GSS[3]=79; GSS[4]=133; GSS[5]=187; GSS[6]=239; GSS[7]=283; GSS[8]=315; GSS[9]=347; GSS[10]=370; GSS[11]=392;
GSC[0]=0; GSC[1]=11; GSC[2]=18; GSC[3]=32; GSC[4]=46; GSC[5]=55; GSC[6]=60; GSC[7]=68; GSC[8]=72; GSC[9]=84; GSC[10]=93;

outN = 0;

@slider
scRoot = slider(1);

// ----- scale -----
g = slider(2);
g < NSG ? (
  mask = LS[GSS[g] + slider(SB + g)];
) : (
  mask = 0; b = 0;
  while (b < 12) ( mask += (slider(CSB + b) >= 0.5) * pow(2, b); b += 1; );
);
scN = 0; b = 0;
while (b < 12) (
  (mask & pow(2, b)) != 0 ? ( SC[scN] = b; SCP[scN] = mod12(scRoot + b); scN += 1; );
  b += 1;
);
scN == 0 ? ( SC[0] = 0; SCP[0] = scRoot; scN = 1; );

// ----- base shape -----
g2 = slider(CGRP);
g2 < NCG ? (
  smask = LH[GSC[g2] + slider(HB + g2)];
) : (
  smask = 0; b = 0;
  while (b < 12) ( smask += (slider(CHB + b) >= 0.5) * pow(2, b); b += 1; );
);
shN = 0; b = 0;
while (b < 12) (
  (smask & pow(2, b)) != 0 ? ( SHP[shN] = mod12(scRoot + b); shN += 1; );
  b += 1;
);
shN == 0 ? ( SHP[0] = scRoot; shN = 1; );

// ----- options -----
DRF[1] = slider(S_DR2) >= 0.5;
DRF[2] = slider(S_DR3) >= 0.5;
DRF[3] = slider(S_DR4) >= 0.5;
TWHOLE = slider(S_TW) >= 0.5;
DBLON = slider(S_DBL) >= 0.5;
HVEL = slider(S_HV);
rlo = slider(S_LO);
rhi = slider(S_HI);

// ----- show only the pickers that matter -----
i = 0;
while (i < NSG) ( slider_show(pow(2, SB + i - 1), g == i); i += 1; );
i = 0;
while (i < 12) ( slider_show(pow(2, CSB + i - 1), g == NSG); i += 1; );
i = 0;
while (i < NCG) ( slider_show(pow(2, HB + i - 1), g2 == i); i += 1; );
i = 0;
while (i < 12) ( slider_show(pow(2, CHB + i - 1), g2 == NCG); i += 1; );

// ----- info text -----
strcpy(#scalestr, "Scale:");
i = 0;
while (i < scN) ( strcat(#scalestr, " "); pc_name(#scalestr, SCP[i]); i += 1; );
strcpy(#shapestr, "Base shape:");
i = 0;
while (i < shN) ( strcat(#shapestr, " "); pc_name(#shapestr, SHP[i]); i += 1; );

@block
while (midirecv(offs, m1, m2, m3)) (
  st = m1 & 0xF0;
  ch = m1 & 0x0F;
  st == 0x90 && m3 > 0 ? (
    (m2 >= rlo && m2 <= rhi) ? ( chord_on(ch, m2, m3, offs); ) : ( midisend(offs, m1, m2, m3); );
  ) : (st == 0x80 || (st == 0x90 && m3 == 0)) ? (
    CNT[ch * 128 + m2] > 0 ? ( chord_off(ch, m2, m3, offs); ) : ( midisend(offs, m1, m2, m3); );
  ) : (
    midisend(offs, m1, m2, m3);
    // all sound off / all notes off: forget what is held on this channel
    (st == 0xB0 && (m2 == 120 || m2 == 123)) ? (
      memset(CNT + ch * 128, 0, 128);
      memset(REFC + ch * 128, 0, 128);
    );
  );
);

@gfx 520 64
gfx_r = 0.85; gfx_g = 0.85; gfx_b = 0.85; gfx_a = 1;
gfx_x = 10; gfx_y = 6;  gfx_drawstr(#scalestr);
gfx_x = 10; gfx_y = 24; gfx_drawstr(#shapestr);
gfx_x = 10; gfx_y = 42; gfx_drawstr(#chordstr);
