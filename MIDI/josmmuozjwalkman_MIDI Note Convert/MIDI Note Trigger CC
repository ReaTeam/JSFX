in_pin:none
out_pin:none

@init

  CCnum = 256;
  CCval = 512;
  
  NOTE_OFF = 8;
  NOTE_ON = 9;

@slider

  note_trigger = slider1;

  CCnum[1] = slider2;
  CCnum[2] = slider4;
  CCnum[3] = slider6;
  CCnum[4] = slider8;
  CCnum[5] = slider10;
  CCnum[6] = slider12;
  CCnum[7] = slider14;
  CCnum[8] = slider16;
  CCnum[9] = slider18;
  CCnum[10] = slider20;

  CCval[1] = slider3;
  CCval[2] = slider5;
  CCval[3] = slider7;
  CCval[4] = slider9;
  CCval[5] = slider11;
  CCval[6] = slider13;
  CCval[7] = slider15;
  CCval[8] = slider17;
  CCval[9] = slider19;
  CCval[10] = slider21;
 
@block

  // function(offset, status_byte, data_byte)
  //          samples, type_chan, MSB, LSB) 
  // midisend(0, $x80, 10, 20) // Note OFF
  // midisend(0, $x90, 10, 20) // Note ON
  // midisend(0, $xBF, 10, 20) // CC on chan 16
  // midisend(0, $xC0, 10, 20) // Program Change
  // midisend(0, $xE0, 10, 20) // Pitch Bend
  
  while (midirecv(offset, type_chan, d_byte1, d_byte2)) (
    
    status_type = (type_chan/16)|0;
    // status_chan = (type_chan-(status_type*16))|0;

    is_note = status_type == NOTE_ON;
    is_trigger = d_byte1 == note_trigger;
    

    (is_note && is_trigger) ? (
      cc_type_chan = type_chan + $x20; // turn note to cc
      
      i = 1;
      loop(10,
        CCnum[i] > 0 ? (
          midisend(offset, cc_type_chan, CCnum[i]-1, CCval[i]);
          // midisend(offset, cc_type_chan, CCnum[i] + (CCval[i] * 256))
        ); 

        i+=1;
      );
    ) : (
      midisend(offset, type_chan, d_byte1, d_byte2);
    );
  );
