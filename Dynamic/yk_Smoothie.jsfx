sln_r = 0;
loop(NSL, SLN[sln_r] = sl_num(sln_r); sln_r += 1;);

i = 0;
while (i < 128) ( M3B_RESP[i] = 0.0; i += 1; );
M3B_RESP[63] = 1.0;
i = 1;
while (i < 64) (
  M3B_RESP[63 + i] = M3B_RESP[62 + i] * 2.0;
  M3B_RESP[63 - i] = M3B_RESP[64 - i] * 0.5;
  i += 1;
);

PI2 = 6.283185307179586;
i = 0;
while (i < PH) (
  WINP[i] = 1 - cos(PI2 * i / PH);
  i < SH ? ( WIN[i] = 1 - cos(PI2 * i / SH); );
  i += 1;
);
i = 0;
while (i < PF) (
  DWINP[i] = 1 - cos(PI2 * i / PF);
  i += 1;
);

i = 0;
while (i < 512) (
  WINW[i] = 1 - cos(PI2 * i / 512);
  i += 1;
);
i = 0;
while (i < 4096) (
  WINPW[i] = 1 - cos(PI2 * i / 4096);
  i += 1;
);

