function m3_shape_scale(f) local(x, p, t, u) (
  x = (f + M3_EPS) / 150.0;
  x > M3_SHAPE_CLAMP ? ( x = M3_SHAPE_CLAMP; );
  p = x * x * x * x;
  t = 1.0 + p;
  u = 1.0 / t;
  u > 0 ? ( u = sqrt(u); );
  u >= 1.0 ? ( u = 1.0; );
  4.0 * u + 1.0;
);

function m3_band_kernel(band, f) local(p, invfc, x, v, d, ad, dd, L, A, q, w, u, g, s, freq, depth, slope, shape, res) (
  freq = m3_bf[band];
  depth = m3_bd[band];
  slope = m3_bs[band];
