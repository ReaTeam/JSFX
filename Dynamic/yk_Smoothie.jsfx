SH = 256;
SF = 512;
SB = 257;
PH = 2048;
PF = 4096;
PB = 2049;
KDIV = floor((srate + 1.0) / 44100.0);
KDIV < 1 ? ( KDIV = 1; );
CFS = srate / KDIV;
CFS < 44100 ? ( CFS = 44100; );
KK = (srate >= 88200.0) ? 2 : 1;
SR_OK = (srate == 44100) || (srate == 48000) || (srate == 88200) || (srate == 96000);
QIDX = floor(slider4 * 2.0 + 0.5);
QIDX < 0 ? ( QIDX = 0; );
QIDX > 2 ? ( QIDX = 2; );
QDIV = (QIDX >= 2) ? 8 : ((QIDX >= 1) ? 4 : 2);
SHOP = SH / QDIV;
PHOP = PH / QDIV;
SN = KK * SF;
PN = KK * PF;
SW = KK * SH;
PW = KK * PH;
SHOPR = KK * SHOP;
PHOPR = KK * PHOP;
SSG = (1.0 / QDIV) / (2.0 * SN);
PSG = (1.0 / QDIV) / (2.0 * PN);

