UI_ab_flash_slot = -1;
UI_ab_flash_on = 0;
UI_LAST_VSIG = -1;
UI_bsc = 1;
UI_MAXSX = 0; UI_MAXSY = 0;
UI_layw = 0; UI_layh = 0;
UI_vw = 0; UI_vh = 0;
UI_dx = 0; UI_dy = 0;
UI_ovx = 0; UI_ovy = 0;
UI_SBW = 0; UI_SBH = 0;

UI_focus_id = -1;
UI_focus_kb = 0;
UI_press_id = -1;
UI_hov_band = -1;
UI_HITR = 16;

UI_edit_id = -1;
UI_edit_sl = 0;
UI_edit_caret = 0;
UI_edit_sel = 0;
UI_field_pending = -1;
UI_field_pending_sl = 0;
UI_field_moved = 0;

UI_gest = 0;
UI_gest_dirty = 0;
UI_pend = 0;
UI_tn = 0;
UI_t0 = 0; UI_t1 = 0; UI_t2 = 0; UI_t3 = 0;
UI_mu_edge = 0;

UI_hv_id = -1;
UI_hv_kind = 0;
UI_hv_sl = 0;
UI_last_hv_id = -1;
UI_hov_t = -10;
UI_tip_show = 0;
UI_defer = 0;
UI_defer_t = 0;

UI_BF  = freemem; freemem += 8;
UI_BD  = freemem; freemem += 8;
UI_BQ  = freemem; freemem += 8;
UI_BS  = freemem; freemem += 8;
UI_BL  = freemem; freemem += 8;
UI_NDY = freemem; freemem += 8;
UI_BU  = freemem; freemem += 8;
UI_BE  = freemem; freemem += 8;
UI_FQ  = freemem; freemem += 16;
UI_FG  = freemem; freemem += 24;

UI_ABS = freemem; freemem += 2 * NSL;

UI_RK  = freemem; freemem += 256;
UI_RX  = freemem; freemem += 256;
UI_RY  = freemem; freemem += 256;
UI_RW  = freemem; freemem += 256;
UI_RH  = freemem; freemem += 256;
UI_RS  = freemem; freemem += 256;
UI_RI  = freemem; freemem += 256;
UI_nreg = 0;

UI_FK  = freemem; freemem += 256;
UI_nfk = 0;

UI_PN    = 192;
UI_GR_A  = freemem; freemem += UI_PN;
UI_GR_R  = freemem; freemem += UI_PN;
UI_GR_H  = freemem; freemem += UI_PN;
UI_GR_M  = freemem; freemem += UI_PN;
UI_GR_B  = freemem; freemem += UI_PN;
UI_KS    = freemem; freemem += UI_PN;
UI_KP    = freemem; freemem += UI_PN;
UI_CUR   = freemem; freemem += UI_GW;
UI_CUR2  = freemem; freemem += UI_GW;
UI_CUR3  = freemem; freemem += UI_GW;
UI_EQ    = freemem; freemem += UI_GW;
UI_PS    = freemem; freemem += UI_GW + 1;
UI_AN_T  = -1;
UI_GR_GEN = 0;
UI_GR_HOLD = 0;
UI_SIG = 0; UI_LAST_SIG = -1; UI_LAST_GEN = -1; UI_GR_CHG = 0;
UI_GR_ON = 0;
UI_MIDY  = (UI_PT + UI_PB) / 2;
UI_YPX   = (UI_PB - 8 - (UI_PT + 8)) / 24;
UI_GR_RANGE = 12;
UI_GYPX  = UI_YPX;
UI_GRL_X = UI_PX1 - 60; UI_GRL_Y = 34; UI_GRL_W = 38; UI_GRL_H = 15;
UI_SD    = freemem; freemem += UI_PN;
UI_PF    = freemem; freemem += UI_PN;
UI_SDSIG = -1;
UI_i = 0;
loop(UI_PN, UI_GR_A[UI_i] = 0; UI_GR_R[UI_i] = 0;
  UI_GR_H[UI_i] = 0; UI_GR_M[UI_i] = 0; UI_GR_B[UI_i] = 0;
  UI_SD[UI_i] = 0; UI_i += 1;);
UI_i = 0;
while (UI_i < UI_PN) (
  UI_PF[UI_i] = 20 * exp(UI_i * 6.907755278982137 / (UI_PN - 1));
  UI_i += 1;
);
UI_i = 0;
loop(UI_GW, UI_CUR[UI_i] = 0; UI_CUR2[UI_i] = 0; UI_CUR3[UI_i] = 0; UI_i += 1;);
UI_i = 0;
loop(UI_GW + 1, UI_PS[UI_i] = 0; UI_i += 1;);
UI_FQ[0] = 20;  UI_FQ[1] = 50;  UI_FQ[2] = 100; UI_FQ[3] = 200; UI_FQ[4] = 500;
UI_FQ[5] = 1000; UI_FQ[6] = 2000; UI_FQ[7] = 5000; UI_FQ[8] = 10000; UI_FQ[9] = 20000;

UI_FG[0] = 20;  UI_FG[1] = 30;  UI_FG[2] = 50;  UI_FG[3] = 100; UI_FG[4] = 200;
UI_FG[5] = 300; UI_FG[6] = 500; UI_FG[7] = 1000; UI_FG[8] = 2000; UI_FG[9] = 3000;
UI_FG[10] = 5000; UI_FG[11] = 10000; UI_FG[12] = 20000;
UI_i = 0;
loop(NSL,
  UI_ABS[UI_i] = slider(SLN[UI_i]);
  UI_ABS[NSL + UI_i] = slider(SLN[UI_i]);
  UI_i += 1;
);
UI_READY = 1;
);
UI_KCFS !== CFS ? (
UI_KCFS = CFS;
UI_i = 0;
while (UI_i < UI_PN) (
  UI_f = 20 * exp(UI_i * 6.907755278982137 / (UI_PN - 1));
  UI_k = floor(UI_f * 512 / CFS + 0.5);
  UI_k < 1 ? ( UI_k = 1; );
  UI_k > SB - 1 ? ( UI_k = SB - 1; );
  UI_KS[UI_i] = UI_k;
  UI_k = floor(UI_f * 4096 / CFS + 0.5);
  UI_k < 1 ? ( UI_k = 1; );
  UI_k > PB - 1 ? ( UI_k = PB - 1; );
  UI_KP[UI_i] = UI_k;
  UI_i += 1;
);
);

function sui_clamp01(v) ( v < 0 ? 0 : (v > 1 ? 1 : v); );

function sui_clamp(v, a, b) ( v < a ? a : (v > b ? b : v); );

function sui_mapx(px) ( (px - UI_dx + UI_SX) / UI_s; );
function sui_mapy(py) ( (py - UI_dy + UI_SY) / UI_s; );

function sui_scroll(wd, wh) (
  UI_SY = min(max(UI_SY - wd * 60 * UI_s, 0), UI_MAXSY);
  UI_SX = min(max(UI_SX + wh * 60 * UI_s, 0), UI_MAXSX);
);

function sui_col(r, g, b, a) ( gfx_set(r / 255, g / 255, b / 255, a); );

function sui_rf(x, y, w, h, r, g, b, a) ( sui_col(r, g, b, a); gfx_rect(x*UI_z, y*UI_z, w*UI_z, h*UI_z, 1); );

function sui_rr(x, y, w, h, rad, r, g, b, a) local(qx, qy, qw, qh, qr) (
  qx = x*UI_z; qy = y*UI_z; qw = w*UI_z; qh = h*UI_z; qr = rad*UI_z;
  sui_col(r, g, b, a);
  gfx_rect(qx + qr, qy, qw - 2 * qr, qh, 1);
  gfx_rect(qx, qy + qr, qr, qh - 2 * qr, 1);
  gfx_rect(qx + qw - qr, qy + qr, qr, qh - 2 * qr, 1);
  gfx_circle(qx + qr, qy + qr, qr, 1, 1);
  gfx_circle(qx + qw - qr - 1, qy + qr, qr, 1, 1);
  gfx_circle(qx + qr, qy + qh - qr - 1, qr, 1, 1);
  gfx_circle(qx + qw - qr - 1, qy + qh - qr - 1, qr, 1, 1);
);

function sui_rro(x, y, w, h, rad, r, g, b, a) ( sui_col(r, g, b, a); gfx_roundrect(x*UI_z, y*UI_z, w*UI_z, h*UI_z, rad*UI_z, 0); );

function sui_ln(x1, y1, x2, y2, r, g, b, a) ( sui_col(r, g, b, a); gfx_line(x1*UI_z, y1*UI_z, x2*UI_z, y2*UI_z, 1); );

function sui_thickln(x1, y1, x2, y2, th, r, g, b, a) local(i) (
  i = 0;
  loop(max(1, floor(th * UI_z)),
    sui_ln(x1, y1 + i * 0.55 / UI_z, x2, y2 + i * 0.55 / UI_z, r, g, b, a);
    i += 1;
  );
);

function sui_circ(cx, cy, rad, fill, r, g, b, a) ( sui_col(r, g, b, a); gfx_circle(cx*UI_z, cy*UI_z, rad*UI_z, fill, 1); );

function sui_trix(x1, y1, x2, y2, x3, y3, x4, y4) (
  gfx_triangle(x1, y1*UI_z, x2, y2*UI_z, x3, y3*UI_z, x4, y4*UI_z);
);

function sui_fnt(sz, bold) local(s) (
  s = floor(sz * UI_z + 0.5);
  s = max(11, min(100, s));
  (s != UI_fsz) || (bold != UI_fbold) ? ( gfx_setfont(1, "Arial", s, bold ? 'b' : 0); UI_fsz = s; UI_fbold = bold; );
);

function sui_txt(s, x, y, sz, bold, r, g, b, a) ( sui_fnt(sz, bold); sui_col(r, g, b, a); gfx_x = x*UI_z; gfx_y = y*UI_z; gfx_drawstr(s); );

function sui_txtc(s, cx, y, sz, bold, r, g, b, a) local(tw, th) (
  sui_fnt(sz, bold); gfx_measurestr(s, tw, th);
  sui_col(r, g, b, a); gfx_x = cx*UI_z - tw*0.5; gfx_y = y*UI_z; gfx_drawstr(s);
);

function sui_txtr(s, rx, y, sz, bold, r, g, b, a) local(tw, th) (
  sui_fnt(sz, bold); gfx_measurestr(s, tw, th);
  sui_col(r, g, b, a); gfx_x = rx*UI_z - tw; gfx_y = y*UI_z; gfx_drawstr(s);
);

function sui_hit(x, y, w, h) ( UI_mx >= x && UI_mx < x + w && UI_my >= y && UI_my < y + h );

function sui_psnap(v) ( floor(v * UI_z + 0.5) / UI_z; );

function sui_ring2(x, y, w, h, rad, r, g, b, a) (
  sui_rro(x - 2, y - 2, w + 4, h + 4, rad + 2, r, g, b, a);
  sui_rro(x - 1, y - 1, w + 2, h + 2, rad + 1, r, g, b, a);
);

function sui_focus_ring(x, y, w, h, r, g, b) (
  sui_rf(x - 2, y - 2, w + 4, 2, r, g, b, 1);
  sui_rf(x - 2, y + h, w + 4, 2, r, g, b, 1);
  sui_rf(x - 2, y, 2, h, r, g, b, 1);
  sui_rf(x + w, y, 2, h, r, g, b, 1);
);

function sui_hover_ring(x, y, w, h) ( sui_rro(x - 3, y - 3, w + 6, h + 6, 4, 0, 103, 192, 1); );

function sui_kb_ring(x, y, w, h) (
  sui_ln(x + 1, y + 1, x + w - 2, y + 1, 0, 95, 184, 1);
  sui_ln(x + 1, y + h - 2, x + w - 2, y + h - 2, 0, 95, 184, 1);
  sui_ln(x + 1, y + 1, x + 1, y + h - 2, 0, 95, 184, 1);
  sui_ln(x + w - 2, y + 1, x + w - 2, y + h - 2, 0, 95, 184, 1);
  sui_ln(x + 2, y + 2, x + w - 3, y + 2, 143, 218, 253, 1);
  sui_ln(x + 2, y + h - 3, x + w - 3, y + h - 3, 143, 218, 253, 1);
  sui_ln(x + 2, y + 2, x + 2, y + h - 3, 143, 218, 253, 1);
  sui_ln(x + w - 3, y + 2, x + w - 3, y + h - 3, 143, 218, 253, 1);
);

function sui_n2f(n) ( 170 * exp(n * 4.775161130324567) - 150; );

function sui_f2x(f) ( UI_PX0 + (UI_PX1 - UI_PX0) * log(max(f, 1) / 20) / 6.907755278982137; );

function sui_x2f(x) ( 20 * exp((x - UI_PX0) / (UI_PX1 - UI_PX0) * 6.907755278982137); );

function sui_x2n(x) local(f) ( f = sui_x2f(x); log((f + 150) / 170) / 4.775161130324567; );

function sui_qval(n) ( 0.1 * pow(100, pow(sui_clamp01(n), 1.2354510125)); );

function sui_shape_snap(n) local(k) (
  k = floor(7 * sui_clamp01(n) + 0.5);
  k == 0 ? 0 : (k == 7 ? 7 : (k == 3 ? 3 : 2));
);

function sui_slope_shape(s) ( s == 0 || s == 7 );

function sui_shape_short(n) local(k) (
  k = floor(7 * sui_clamp01(n) + 0.5);
  k == 0 ? strcpy(#ui_fmt, "Low cut") :
  k == 2 ? strcpy(#ui_fmt, "Bell") :
  k == 3 ? strcpy(#ui_fmt, "Detail only") :
  k == 7 ? strcpy(#ui_fmt, "High cut") :
  strcpy(#ui_fmt, "Bell (no detail)");
);

function sui_slope_db(n) ( exp(log(6) + log(21.3333333333) * sui_clamp01(n)); );

function sui_slope_db_at(k) ( k == 0 ? 6 : (k == 1 ? 12 : (k == 2 ? 24 : (k == 3 ? 48 : 96))); );

function sui_slope_n_at(k) local(d) ( d = sui_slope_db_at(k); log(d / 6) / log(21.3333333333); );

function sui_slope_step(n) local(d, best, bk, k) (
  d = sui_slope_db(n); best = 999; bk = 2; k = 0;
  loop(5, abs(d - sui_slope_db_at(k)) < best ? ( best = abs(d - sui_slope_db_at(k)); bk = k; ); k += 1;);
  bk;
);

function sui_slope_step_db(n) ( sui_slope_db_at(sui_slope_step(n)); );

function sui_slope_step_from_db(d) local(best, bk, k) (
  best = 999; bk = 2; k = 0;
  loop(5, abs(d - sui_slope_db_at(k)) < best ? ( best = abs(d - sui_slope_db_at(k)); bk = k; ); k += 1;);
  bk;
);

function sui_slope_snap_n(n) ( sui_slope_n_at(sui_slope_step(n)); );

function sui_is_slope(sl) ( sl >= 20 && sl <= 91 && ((sl - 20) - 9 * floor((sl - 20) / 9)) == 5 );

function sui_fmt_freq(f) (
  f < 1000 ? sprintf(#ui_rfq, "%.0f Hz", f) :
  f < 10000 ? sprintf(#ui_rfq, "%.2f kHz", f / 1000) :
  sprintf(#ui_rfq, "%.1f kHz", f / 1000);
);

function sui_fmt_gain(d) (
  abs(d) < 0.05 ? strcpy(#ui_rgn, "0.0 dB") : sprintf(#ui_rgn, "%+.1f dB", d);
);

function sui_vfmt(sl) local(n, b, o, f, d, k, q) (
  n = sui_clamp01(slider(sl));
  b = floor((sl - 20) / 9);
  o = (sl - 20) - 9 * b;
  (sl == 1) || (sl == 6) || (sl == 7) || (sl == 8) ? sprintf(#ui_fmt, "%.1f", n * 10) :
  (sl >= 9 && sl <= 14) ? sprintf(#ui_fmt, "%.2f", n * 2) :
  (sl == 2) ? strcpy(#ui_fmt, "Low latency") :
  (sl == 3) ? ( n >= 0.5 ? strcpy(#ui_fmt, "Hard") : strcpy(#ui_fmt, "Soft") ) :
  (sl == 4) ? ( k = floor(2 * n + 0.5); k == 0 ? strcpy(#ui_fmt, "Normal") : (k == 1 ? strcpy(#ui_fmt, "High") : strcpy(#ui_fmt, "Ultra")); ) :
  (sl == 5) ? strcpy(#ui_fmt, "Linear phase") :
  (sl == 15) ? strcpy(#ui_fmt, "Sidechain") :
  (sl == 16) ? strcpy(#ui_fmt, "Sidechain listen") :
  (sl == 17) ? ( n >= 0.5 ? strcpy(#ui_fmt, "M/S") : strcpy(#ui_fmt, "L/R") ) :
  (sl == 18) ? sprintf(#ui_fmt, "%d", floor(100 * n + 0.5)) :
  (sl == 19) ? ( abs(n - 0.5) < 0.02 ? strcpy(#ui_fmt, "Even") : sprintf(#ui_fmt, "L%d/R%d", floor(100 * (1 - n) + 0.5), floor(100 * n + 0.5)) ) :
  (sl >= 20 && sl <= 91) ? (
    o == 0 ? ( n >= 0.5 ? strcpy(#ui_fmt, "Used") : strcpy(#ui_fmt, "Unused") ) :
    o == 1 ? ( n >= 0.5 ? strcpy(#ui_fmt, "On") : strcpy(#ui_fmt, "Off") ) :
    o == 2 ? ( f = sui_n2f(n); sprintf(#ui_fmt, "%.0f", f); ) :
    o == 3 ? ( d = 24 * n - 12; abs(d) < 0.05 ? strcpy(#ui_fmt, "0.0") : sprintf(#ui_fmt, "%+.1f", d); ) :
    o == 4 ? sprintf(#ui_fmt, "%.2f", sui_qval(n)) :
    o == 5 ? sprintf(#ui_fmt, "%.0f", sui_slope_step_db(n)) :
    o == 6 ? ( abs(n - 0.5) < 0.02 ? strcpy(#ui_fmt, "Even") : sprintf(#ui_fmt, "L%d/R%d", floor(100 * (1 - n) + 0.5), floor(100 * n + 0.5)) ) :
    sui_shape_short(n);
  ) :
  (sl == 92) ? ( k = floor(8 * n + 0.5); k == 0 ? strcpy(#ui_fmt, "Off") : sprintf(#ui_fmt, "Band %d", k); ) :
  (sl == 93) ? ( n >= 0.999 ? strcpy(#ui_fmt, "Off") : sprintf(#ui_fmt, "%.0f", 24 * n) ) :
  (sl == 94) || (sl == 96) ? ( d = 36 * n - 18; abs(d) < 0.05 ? strcpy(#ui_fmt, "0.0") : sprintf(#ui_fmt, "%+.1f", d); ) :
  (sl == 95) ? sprintf(#ui_fmt, "%d", floor(100 * n + 0.5)) :
  (sl == 97) ? strcpy(#ui_fmt, "Delta") :
  (sl == 98) ? strcpy(#ui_fmt, "Bypass") :
  sprintf(#ui_fmt, "%.2f", n);
);

function sui_defval(sl) (
  ser_def(sl);
);

function sui_tip_label(id, sl) (
  (id == 1100) || (id == 2100) ? strcpy(#ui_tip_lab, "Depth") :
  (id == 1101) || (id == 2101) ? strcpy(#ui_tip_lab, "Detail") :
  (id == 1102) || (id == 2102) ? strcpy(#ui_tip_lab, "Attack") :
  (id == 1103) || (id == 2103) ? strcpy(#ui_tip_lab, "Release") :
  (id == 1104) || (id == 2104) ? strcpy(#ui_tip_lab, "Mix") :
  (id == 1105) || (id == 2105) ? strcpy(#ui_tip_lab, "Out") :
  (id == 1002) || (id == 2002) ? strcpy(#ui_tip_lab, "Freq") :
  (id == 1003) || (id == 2003) ? strcpy(#ui_tip_lab, "Depth") :
  (id == 1004) || (id == 2004) ? strcpy(#ui_tip_lab, "Q") :
  (id == 1005) || (id == 2005) ? strcpy(#ui_tip_lab, "Slope") :
  (id == 1006) || (id == 2006) ? strcpy(#ui_tip_lab, "Focus") :
  (id == 1001) ? strcpy(#ui_tip_lab, "Enabled") :
  (id == 3009) ? strcpy(#ui_tip_lab, "Solo") :
  (id == 200) ? strcpy(#ui_tip_lab, "Shape") :
  (id == 202) ? strcpy(#ui_tip_lab, "Quality") :
  (id == 203) ? strcpy(#ui_tip_lab, "Mode") :
  (id == 204) ? strcpy(#ui_tip_lab, "Stereo") :
  (id == 205) ? strcpy(#ui_tip_lab, "Max cut") :
  (id == 2098) ? strcpy(#ui_tip_lab, "Link") :
  (id == 2099) ? strcpy(#ui_tip_lab, "Global focus") :
  (id == 2094) ? strcpy(#ui_tip_lab, "Wet") :
  (id == 1015) ? strcpy(#ui_tip_lab, "Sidechain") :
  (id == 4001) ? strcpy(#ui_tip_lab, "A") :
  (id == 4002) ? strcpy(#ui_tip_lab, "B") :
  (id == 4003) ? strcpy(#ui_tip_lab, "Copy A>B") :
  (id == 4004) ? strcpy(#ui_tip_lab, "Copy B>A") :
  (id == 1901) ? strcpy(#ui_tip_lab, "Show grid") :
  (id == 1902) ? strcpy(#ui_tip_lab, "GR scale") :
  (id == 101) ? strcpy(#ui_tip_lab, "Band") :
  (id == 105) ? strcpy(#ui_tip_lab, "Tilt") :
  (id == 102) ? strcpy(#ui_tip_lab, "Add band") :
  (id == 103) ? strcpy(#ui_tip_lab, "Remove band") :
  (id == 104) ? strcpy(#ui_tip_lab, "Reset band") :
  (id == 3098) ? strcpy(#ui_tip_lab, "Bypass") :
  (id == 3097) ? strcpy(#ui_tip_lab, "Delta") :
  (id == 3002) ? strcpy(#ui_tip_lab, "Low latency") :
  (id == 3005) ? strcpy(#ui_tip_lab, "Linear phase") :
  (id == 3016) ? strcpy(#ui_tip_lab, "Sidechain listen") :
  (id >= 1009 && id <= 1014) ? (
    (id == 1009) || (id == 1010) ? strcpy(#ui_tip_lab, "Detail") :
    (id == 1011) || (id == 1012) ? strcpy(#ui_tip_lab, "Attack") :
    strcpy(#ui_tip_lab, "Release");
    strcat(#ui_tip_lab, (id == 1009 || id == 1011 || id == 1013) ? " low" : " high");
  ) :
  (id >= 2009 && id <= 2014) ? (
    (id == 2009) || (id == 2010) ? strcpy(#ui_tip_lab, "Detail") :
    (id == 2011) || (id == 2012) ? strcpy(#ui_tip_lab, "Attack") :
    strcpy(#ui_tip_lab, "Release");
    strcat(#ui_tip_lab, (id == 2009 || id == 2011 || id == 2013) ? " low" : " high");
  ) :
  (id >= 8000 && id <= 8007) ? sprintf(#ui_tip_lab, "Band %d", id - 7999) :
  (id >= 6000 && id <= 6007) ? sprintf(#ui_tip_lab, "Band %d", id - 5999) :
  (sl > 0) ? sprintf(#ui_tip_lab, "Slider %d", sl) :
  strcpy(#ui_tip_lab, "");
);

function sui_tip_value(id, kind, sl) local(b) (
  strcpy(#ui_tip_val, "");
  (id >= 6000 && id <= 6007) || (id >= 8000 && id <= 8007) ? (
    b = id - ((id >= 8000) ? 8000 : 6000);
    sui_fmt_freq(UI_BF[b]);
    sui_slope_shape(UI_BS[b]) ? ( sui_shape_short(slider(28 + 9 * b)); sprintf(#ui_tip_val, "%s / %s", #ui_rfq, #ui_fmt); ) :
      ( sui_fmt_gain(UI_BD[b]); sprintf(#ui_tip_val, "%s / %s", #ui_rfq, #ui_rgn); );
  ) :
  (id == 1901) ? strcpy(#ui_tip_val, UI_showgrid ? "On" : "Off") :
  (id == 1902) ? sprintf(#ui_tip_val, "0..-%d dB", UI_GR_RANGE) :
  (id == 3009) ? (
    abs(sui_clamp01(slider(92)) - (UI_sel + 1) / 8) < 0.02 ? strcpy(#ui_tip_val, "On") : strcpy(#ui_tip_val, "Off");
  ) :
  (kind == 3) ? (
    sl > 0 ? ( slider(sl) >= 0.5 ? strcpy(#ui_tip_val, "On") : strcpy(#ui_tip_val, "Off") ) : 0;
  ) :
  (sl > 0 && (kind == 1 || kind == 2 || kind == 4)) ? (
    sui_vfmt(sl); strcpy(#ui_tip_val, #ui_fmt);
  ) : 0;
);

function sui_tip_hint(id, kind) (
  (kind == 1) || (kind == 2) ? strcpy(#ui_tip_hint, "dbl-click reset | wheel/arrows") :
  (kind == 8) ? (
    sui_slope_shape(UI_BS[id - 6000]) ? strcpy(#ui_tip_hint, "drag freq | dbl-click none") :
      strcpy(#ui_tip_hint, "drag freq/depth | dbl-click depth 0");
  ) :
  (kind == 7) ? strcpy(#ui_tip_hint, "click select") :
  (id == 3009) ? strcpy(#ui_tip_hint, "listen to this band only") :
  (id == 3016) ? strcpy(#ui_tip_hint, "hear the sidechain input (pins 3/4); overrides Solo/Delta/Mix") :
  (kind == 3) ? strcpy(#ui_tip_hint, "click/Enter toggle") :
  (kind == 4) ? strcpy(#ui_tip_hint, "click/Enter menu") :
  (kind == 5) ? strcpy(#ui_tip_hint, "click/Enter") :
  (kind == 9) ? strcpy(#ui_tip_hint, "click 12/18/24 dB") :
  strcpy(#ui_tip_hint, "");
);

function sui_tip_build(id, kind, sl) (
  sui_tip_label(id, sl);
  sui_tip_value(id, kind, sl);
  sui_tip_hint(id, kind);
  strlen(#ui_tip_lab) == 0 ? strcpy(#ui_tip_txt, "") :
  strlen(#ui_tip_val) == 0 ? sprintf(#ui_tip_txt, "%s  |  %s", #ui_tip_lab, #ui_tip_hint) :
  strlen(#ui_tip_hint) == 0 ? sprintf(#ui_tip_txt, "%s: %s", #ui_tip_lab, #ui_tip_val) :
  sprintf(#ui_tip_txt, "%s: %s  |  %s", #ui_tip_lab, #ui_tip_val, #ui_tip_hint);
);

function sui_tip_draw() local(tw, th, bw, bh, bx, by, vx0, vx1, vy0, vy1) (
  sui_tip_build(UI_hv_id, UI_hv_kind, UI_hv_sl);
  strlen(#ui_tip_txt) == 0 ? 0 : (
    sui_fnt(11, 0);
    gfx_measurestr(#ui_tip_txt, tw, th);
    bw = tw / UI_z + 14; bh = 20;
    bx = UI_mx + 14; by = UI_my + 18;
    vx0 = UI_SX / UI_s; vx1 = (UI_SX + UI_vw) / UI_s;
    vy0 = UI_SY / UI_s; vy1 = (UI_SY + UI_vh) / UI_s;
    vx0 < 12 ? vx0 = 12 : 0; vy0 < 32 ? vy0 = 32 : 0;
    vx1 > 1188 ? vx1 = 1188 : 0; vy1 > 706 ? vy1 = 706 : 0;
    (bx + bw > vx1) ? bx = UI_mx - bw - 14 : 0;
    (by + bh > vy1) ? by = UI_my - bh - 18 : 0;
    bx = sui_clamp(bx, vx0, max(vx0, vx1 - bw));
    by = sui_clamp(by, vy0, max(vy0, vy1 - bh));
    sui_rf(bx, by, bw, bh, 255, 255, 225, 1);
    sui_rro(bx, by, bw, bh, 2, 118, 118, 118, 1);
    sui_rro(bx - 1, by - 1, bw + 2, bh + 2, 3, 118, 118, 118, 1);
    sui_txt(#ui_tip_txt, bx + 6, by + 3, 11, 0, 0, 0, 0, 1);
  );
);

