function m3_clip01(x) ( x < 0 ? 0 : ( x > 1 ? 1 : x ); );

function m3_max(a, b) ( a > b ? a : b; );

function m3_min(a, b) ( a < b ? a : b; );

function m3_round(x) ( floor(x + 0.5); );

function m3_clamp_curve(v) ( m3_min(m3_max(v, 0.00000011920928955078125), 0.9999998807907104); );

function m3_pow2(n) local(a, b) (
  (n < -126 || n > 126) ? ( pow(2, n); ) : (
    a = floor(n * 0.5 + 0.5);
    b = n - a;
    M3B_RESP[a + 63] * M3B_RESP[b + 63];
  );
);

function m3_exp(x) local(n, r, p) (
  n = floor(x * M3_LOG2E_F + 0.5);
  r = x - n * M3_LN2_HI - n * M3_LN2_LO;
  p = 0.008291719481348991;
  p = p * r + 0.041873522102832794;
  p = p * r + 0.16667431592941284;
  p = p * r + 0.4999939203262329;
  p = p * r + 0.9999998807907104;
  p = p * r + 1.0;
  m3_pow2(n) * p;
);

function m3_log(x) local(e, f, p, m) (
  e = floor(log(x) * M3_LOG2E + 0.5849625007211562);
  m = x * m3_pow2(-e) - 1.0;
  while (m < -0.33333334) (
    e = e - 1;
    m = x * m3_pow2(-e) - 1.0;
  );
  while (m >= 0.33333334) (
    e = e + 1;
    m = x * m3_pow2(-e) - 1.0;
  );
  f = m;
  p = -0.15177205204963684;
  p = p * f + 0.16964881122112274;
  p = p * f - 0.16462457180023193;
  p = p * f + 0.19822503626346588;
  p = p * f - 0.25004664063453674;
  p = p * f + 0.33336564898490906;
  p = p * f - 0.5;
  p = f * p;
