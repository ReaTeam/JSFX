function sui_reset_sl(sl) local(d) (
  d = UI_defer; UI_defer = 0;
  sui_set_sl(sl, sui_defval(sl));
  d ? ( UI_pend ? 0 : sliderchange(-1) ) : 0;
);

function sui_ab_save(slot) local(base, i) (
  base = slot * NSL; i = 0;
  loop(NSL, UI_ABS[base + i] = slider(SLN[i]); i += 1;);
);

function sui_ab_copy(src, dst) local(sb, db, i) (
  sb = src * NSL; db = dst * NSL; i = 0;
  loop(NSL, UI_ABS[db + i] = UI_ABS[sb + i]; i += 1;);
);

function sui_ab_eq(slot) local(base, i, bad) (
  base = slot * NSL; bad = 0; i = 0;
  while (i < NSL && !bad) (
    abs(slider(SLN[i]) - UI_ABS[base + i]) > 0.000001 ? bad = 1;
    i += 1;
  );
  !bad;
);

function sui_ab_derive() local(ea, eb) (
  ea = sui_ab_eq(0); eb = sui_ab_eq(1);
  (ea && eb) ? ( UI_ab_chip = UI_ab_active; ) :
  ea ? ( UI_ab_active = 0; UI_ab_chip = 0; ) :
  eb ? ( UI_ab_active = 1; UI_ab_chip = 1; ) :
  ( UI_ab_chip = 2; );
);

function sui_ab_restore(slot) local(base, i, changed) (
  base = slot * NSL; changed = 0;
  UI_ab_batch = 1; i = 0;
  while (i < NSL) (
    (slider(SLN[i]) != UI_ABS[base + i]) ? (
      sui_set_sl(SLN[i], UI_ABS[base + i]); changed = 1;
    );
    i += 1;
  );
  UI_ab_batch = 0;
  changed ? ( UI_pend = 1; );
  changed;
);

function sui_ab_flash(slot) (
  UI_ab_flash_t = UI_now; UI_ab_flash_slot = slot;
);

function sui_ab_toggle(slot) local(changed) (
  sui_gest_end_wheel();
  sui_ab_derive();
  changed = 0;
  (slot != UI_ab_active) ? (
    sui_ab_save(UI_ab_active);
    UI_ab_active = slot; UI_ab_chip = slot;
    changed = sui_ab_restore(slot);
  ) : (
    (UI_ab_chip == 2) ? ( changed = sui_ab_restore(slot); ) : 0;
    UI_ab_chip = slot;
  );
  sui_ab_flash(slot);
  changed;
);

function sui_ab_copy_to(dst) local(changed) (
  sui_gest_end_wheel();
  sui_ab_derive();
  sui_ab_save(UI_ab_active);
  sui_ab_copy(1 - dst, dst);
  changed = 0;
  (dst == UI_ab_active) ? ( changed = sui_ab_restore(dst); );
  sui_ab_flash(dst);
  changed;
);

function sui_wheel_step(sl) local(b, o) (
  b = floor((sl - 20) / 9);
  o = (sl - 20) - 9 * b;
  (sl == 1) || (sl == 6) || (sl == 7) || (sl == 8) ||
  (sl >= 9 && sl <= 14) ? 0.005 :
  (sl >= 20 && sl <= 91) ? (
    o == 2 ? 0.005 :
    o == 3 ? 0.0041666667 :
    o == 4 ? 0.005 :
    o == 5 ? 0.25 :
    o == 6 ? 0.01 :
    o == 7 ? 0.0526315789 :
    o == 8 ? 0.25 :
    0.005
  ) :
  (sl == 18) || (sl == 19) ? 0.01 :
  (sl == 94) || (sl == 96) ? 0.0027777778 :
  (sl == 95) ? 0.01 :
  0.005;
);

function sui_wheel_hit() local(i, r) (
  r = -1; i = UI_nreg - 1;
  while (i >= 0) (
    (r < 0 && sui_hit(UI_RX[i], UI_RY[i], UI_RW[i], UI_RH[i])) ? r = i;
    i -= 1;
  );
  r;
);

function sui_wheel_apply(sl, d) local(n, f) (
  f = UI_shift ? 0.2 : (UI_ctrl ? 5 : 1);
  (d != 0) ? (
    n = sui_clamp01(slider(sl) + d * f * sui_wheel_step(sl));
    sui_is_slope(sl) ? ( n = sui_slope_snap_n(n); );
    sui_set_sl(sl, n);
  ) : 0;
);

function sui_key_begin() (
  (UI_gest && UI_wgest) ? 0 : sui_gest_begin();
  UI_wgest = 1; UI_wt = UI_now;
);

function sui_key_step(sl, dir) (
  sui_key_begin();
  sui_wheel_apply(sl, dir);
);

function sui_key_home_end(sl, home) local(n) (
  sui_key_begin();
  n = home ? 0 : 1;
  sui_is_slope(sl) ? n = sui_slope_snap_n(n) : 0;
  sui_set_sl(sl, n);
);

function sui_reg(k, x, y, w, h, sl, id) (
  UI_RK[UI_nreg] = k; UI_RX[UI_nreg] = x; UI_RY[UI_nreg] = y; UI_RW[UI_nreg] = w; UI_RH[UI_nreg] = h;
  UI_RS[UI_nreg] = sl; UI_RI[UI_nreg] = id; UI_nreg += 1;
);

function sui_edit_seed(sl) local(n, b, o) (
  n = sui_clamp01(slider(sl));
  b = floor((sl - 20) / 9);
  o = (sl - 20) - 9 * b;
  sui_is_slope(sl) ? sprintf(#ui_edit_buf, "%.0f", sui_slope_step_db(n)) :
  ((sl == 19) || (sl >= 20 && sl <= 91 && o == 6)) ? sprintf(#ui_edit_buf, "%d", floor(100 * n + 0.5)) :
  ( sui_vfmt(sl); strcpy(#ui_edit_buf, #ui_fmt); );
  UI_edit_caret = strlen(#ui_edit_buf);
  UI_edit_sel = 1;
);

function sui_start_edit(id, sl) (
  UI_edit_id = id; UI_edit_sl = sl;
  sui_edit_seed(sl);
  UI_focus_id = id; UI_focus_kb = 1;
  UI_drag = 0; UI_drag_kind = 0;
  UI_click_id = -1;
);

function sui_edit_cancel() ( UI_edit_id = -1; UI_edit_sel = 0; );

function sui_edit_current(sl) local(n, b, o) (
  n = sui_clamp01(slider(sl));
  b = floor((sl - 20) / 9);
  o = (sl - 20) - 9 * b;
  sui_is_slope(sl) ? sui_slope_step_db(n) :
  (sl == 1) || (sl == 6) || (sl == 7) || (sl == 8) ? 10 * n :
  (sl >= 9 && sl <= 14) ? 2 * n :
  (sl == 18) ? 100 * n :
  (sl == 19) ? 100 * n :
  (sl >= 20 && sl <= 91) ? (
    o == 2 ? sui_n2f(n) :
    o == 3 ? 24 * n - 12 :
    o == 4 ? sui_qval(n) :
    o == 5 ? sui_slope_step_db(n) :
    o == 6 ? 100 * n :
    100 * n;
  ) :
  (sl == 94) || (sl == 96) ? 36 * n - 18 :
  (sl == 95) ? 100 * n :
  100 * n;
);

function sui_edit_parse(sl, text) local(n, b, o, v) (
  n = -999;
  match("%f", text, v) ? (
    b = floor((sl - 20) / 9);
    o = (sl - 20) - 9 * b;
    (sl == 1) || (sl == 6) || (sl == 7) || (sl == 8) ? n = sui_clamp(v, 0, 10) / 10 :
    (sl >= 9 && sl <= 14) ? n = sui_clamp(v, 0, 2) / 2 :
    (sl == 18) ? n = sui_clamp(v, 0, 100) / 100 :
    (sl == 19) ? n = sui_clamp(v, 0, 100) / 100 :
    (sl >= 20 && sl <= 91) ? (
      o == 2 ? n = log((sui_clamp(v, 20, 20000) + 150) / 170) / 4.775161130324567 :
      o == 3 ? n = (sui_clamp(v, -12, 12) + 12) / 24 :
      o == 4 ? ( v > 0 ? n = pow(log(sui_clamp(v, 0.1, 10) / 0.1) / log(100), 1 / 1.2354510125) : n = -999 ) :
      o == 5 ? n = sui_slope_n_at(sui_slope_step_from_db(sui_clamp(v, 6, 96))) :
      o == 6 ? n = sui_clamp(v, 0, 100) / 100 :
      0;
    ) :
    (sl == 94) || (sl == 96) ? n = (sui_clamp(v, -18, 18) + 18) / 36 :
    (sl == 95) ? n = sui_clamp(v, 0, 100) / 100 :
    0;
    (n > -900) ? n = sui_clamp01(n);
  );
  n;
);

function sui_edit_step_size(sl) local(b, o) (
  b = floor((sl - 20) / 9);
  o = (sl - 20) - 9 * b;
  (sl == 1) || (sl == 6) || (sl == 7) || (sl == 8) ? 0.1 :
  (sl >= 9 && sl <= 14) ? 0.01 :
  (sl == 18) || (sl == 19) ? 1 :
  (sl >= 20 && sl <= 91) ? (
    o == 2 ? 1 : o == 3 ? 0.1 : o == 4 ? 0.01 : o == 5 ? 1 : o == 6 ? 1 : 0.01
  ) :
  (sl == 94) || (sl == 96) ? 0.1 :
  (sl == 95) ? 1 :
  0.01;
);

function sui_edit_fmt(sl, v) local(b, o) (
  b = floor((sl - 20) / 9);
  o = (sl - 20) - 9 * b;
  (sl == 1) || (sl == 6) || (sl == 7) || (sl == 8) ? sprintf(#ui_edit_buf, "%.1f", v) :
  (sl >= 9 && sl <= 14) ? sprintf(#ui_edit_buf, "%.2f", v) :
  (sl == 18) ? sprintf(#ui_edit_buf, "%.0f", v) :
  (sl == 19) ? sprintf(#ui_edit_buf, "%.0f", v) :
  (sl >= 20 && sl <= 91) ? (
    o == 2 ? sprintf(#ui_edit_buf, "%.0f", v) :
    o == 3 ? sprintf(#ui_edit_buf, "%.1f", v) :
    o == 4 ? sprintf(#ui_edit_buf, "%.2f", v) :
    o == 5 ? sprintf(#ui_edit_buf, "%.0f", v) :
    o == 6 ? sprintf(#ui_edit_buf, "%.0f", v) :
    sprintf(#ui_edit_buf, "%.2f", v)
  ) :
  (sl == 94) || (sl == 96) ? sprintf(#ui_edit_buf, "%.1f", v) :
  (sl == 95) ? sprintf(#ui_edit_buf, "%.0f", v) :
  sprintf(#ui_edit_buf, "%.2f", v);
);

function sui_edit_step(sl, dir, fine) local(v, n, st) (
  v = sui_edit_current(sl);
  sui_is_slope(sl) ? (
    st = sui_slope_step(slider(sl)) + dir;
    n = sui_slope_n_at(sui_clamp(st, 0, 4));
  ) : (
    st = sui_edit_step_size(sl) * (fine ? 0.1 : 1);
    sui_edit_fmt(sl, v + dir * st);
    n = sui_edit_parse(sl, #ui_edit_buf);
  );
  (n > -900) ? (
    sui_set_sl(sl, n);
    sui_edit_seed(sl);
    UI_edit_sel = 0;
    UI_edit_caret = strlen(#ui_edit_buf);
  ) : 0;
);

function sui_edit_home_end(sl, home) local(n) (
  n = home ? 0 : 1;
  sui_is_slope(sl) ? n = home ? 0 : sui_slope_n_at(4) : 0;
  sui_set_sl(sl, n);
  sui_edit_seed(sl);
  UI_edit_sel = 0;
  UI_edit_caret = strlen(#ui_edit_buf);
);

function sui_edit_insert(c) local(n) (
  UI_edit_sel ? ( strcpy(#ui_edit_buf, ""); UI_edit_caret = 0; ) : 0;
  n = strlen(#ui_edit_buf);
  UI_edit_caret = sui_clamp(UI_edit_caret, 0, n);
  strcpy_substr(#ui_edit_pre, #ui_edit_buf, 0, UI_edit_caret);
  strcpy_substr(#ui_edit_suf, #ui_edit_buf, UI_edit_caret, n - UI_edit_caret);
  c == 44 ? c = 46;
  sprintf(#ui_edit_buf, "%s%c%s", #ui_edit_pre, c, #ui_edit_suf);
  UI_edit_caret += 1;
  UI_edit_sel = 0;
);

function sui_edit_delete() local(n) (
  UI_edit_sel ? ( strcpy(#ui_edit_buf, ""); UI_edit_caret = 0; UI_edit_sel = 0; ) : (
    n = strlen(#ui_edit_buf);
    UI_edit_caret < n ? (
      strcpy_substr(#ui_edit_pre, #ui_edit_buf, 0, UI_edit_caret);
      strcpy_substr(#ui_edit_suf, #ui_edit_buf, UI_edit_caret + 1, n - UI_edit_caret - 1);
      sprintf(#ui_edit_buf, "%s%s", #ui_edit_pre, #ui_edit_suf);
    ) : 0;
  );
);

function sui_edit_commit() local(n) (
  UI_edit_id >= 0 ? (
    n = sui_edit_parse(UI_edit_sl, #ui_edit_buf);
    (n > -900) ? sui_set_sl(UI_edit_sl, n) : 0;
    UI_edit_id = -1; UI_edit_sel = 0;
  ) : 0;
);

function sui_start_fader(id, sl, x, w) local(v) (
  v = sui_clamp01((UI_mx - (x + 10)) / max(1, w - 20));
  sui_is_slope(sl) ? v = sui_slope_snap_n(v);
  sui_gest_begin();
  sui_set_sl(sl, v);
  UI_drag = 1; UI_drag_kind = 1; UI_drag_sl = sl;
  UI_drag_x0 = UI_mx; UI_drag_v0 = v; UI_drag_w = max(1, w - 20);
  UI_focus_id = id; UI_focus_kb = 0;
);

function sui_start_field(id, sl) (
  sui_edit_commit();
  sui_gest_begin();
  UI_drag = 1; UI_drag_kind = 2; UI_drag_sl = sl;
  UI_drag_x0 = UI_mx; UI_drag_y0 = UI_my; UI_drag_v0 = sui_clamp01(slider(sl));
  UI_field_pending = id; UI_field_pending_sl = sl; UI_field_moved = 0;
  UI_focus_id = id; UI_focus_kb = 0;
);

function sui_used_count() local(i, n) (
  n = 0; i = 0;
  loop(8, slider(20 + 9 * i) >= 0.5 ? n += 1; i += 1;);
  n;
);

function sui_add_band() local(i, found) (
  i = 0; found = -1;
  loop(8,
    (found < 0 && slider(20 + 9 * i) < 0.5) ? found = i;
    i += 1;
  );
  found >= 0 ? (
    sui_set_sl(20 + 9 * found, 1);
    sui_set_sl(21 + 9 * found, 1);
    UI_sel = found; UI_sect = 0;
  );
);

function sui_remove_band() ( sui_set_sl(20 + 9 * UI_sel, 0); );

function sui_reset_band() local(base) (
  base = 20 + 9 * UI_sel;
  sui_set_sl(base + 1, 1);
  sui_set_sl(base + 2, sui_defval(base + 2));
  sui_set_sl(base + 3, sui_defval(base + 3));
  sui_set_sl(base + 4, sui_defval(base + 4));
  sui_set_sl(base + 5, sui_defval(base + 5));
  sui_set_sl(base + 6, sui_defval(base + 6));
  sui_set_sl(base + 8, sui_defval(base + 8));
);

function sui_toggle_solo() local(v) (
  v = sui_clamp01(slider(92));
  v > 0 ? (
    abs(v - (UI_sel + 1) / 8) < 0.01 ? sui_set_sl(92, 0) : sui_set_sl(92, (UI_sel + 1) / 8);
  ) : sui_set_sl(92, (UI_sel + 1) / 8);
);

function sui_page_action(id) (
  id == 101 ? ( UI_sect = 0; ) :
  id == 102 ? ( sui_add_band(); ) :
  id == 103 ? ( sui_remove_band(); ) :
  id == 104 ? ( sui_reset_band(); ) :
  id == 105 ? ( UI_sect = 1; ) :
  id == 4001 ? ( sui_ab_toggle(0); ) :
  id == 4002 ? ( sui_ab_toggle(1); ) :
  id == 4003 ? ( sui_ab_copy_to(1); ) :
  id == 4004 ? ( sui_ab_copy_to(0); ) : 0;
);

function sui_do_menu(id, sl) local(pick) (
  gfx_x = UI_mx * UI_z; gfx_y = UI_my * UI_z;
  id == 200 ? (
    pick = gfx_showmenu("Low cut|Bell|High cut");
    pick == 1 ? sui_set_sl(28 + 9 * UI_sel, 0) :
    pick == 2 ? sui_set_sl(28 + 9 * UI_sel, 2 / 7) :
    pick == 3 ? sui_set_sl(28 + 9 * UI_sel, 1) : 0;
    UI_last_md = 1;
  ) :
  id == 202 ? (
    pick = gfx_showmenu("normal|high|ultra");
    pick > 0 ? sui_set_sl(4, (pick - 1) / 2);
    UI_last_md = 1;
  ) :
  id == 203 ? (
    pick = gfx_showmenu("soft|hard");
    pick == 1 ? sui_set_sl(3, 0) : pick == 2 ? sui_set_sl(3, 1);
    UI_last_md = 1;
  ) :
  id == 204 ? (
    pick = gfx_showmenu("l/r|m/s");
    pick > 0 ? sui_set_sl(17, pick == 1 ? 0 : 1);
    UI_last_md = 1;
  ) :
  id == 205 ? (
    pick = gfx_showmenu("Off|3|6|12|18");
    pick > 0 ? sui_set_sl(93, pick == 1 ? 1 : (pick == 2 ? 0.125 : (pick == 3 ? 0.25 : (pick == 4 ? 0.5 : 0.75))));
    UI_last_md = 1;
  ) : 0;
);

function sui_focus_move(dir) local(i, idx) (
  idx = -1; i = 0;
  loop(UI_nfk, UI_FK[i] == UI_focus_id ? idx = i; i += 1;);
  UI_nfk > 0 ? (
    idx = idx < 0 ? (dir > 0 ? 0 : UI_nfk - 1) : ((idx + dir + UI_nfk) % UI_nfk);
    UI_focus_id = UI_FK[idx];
    UI_focus_kb = 1;
  ) : 0;
);

function sui_reg_index(id) local(i, r) (
  r = -1; i = 0;
  loop(UI_nreg, UI_RI[i] == id ? r = i; i += 1;);
  r;
);

function sui_focus_is_field() local(i, k) (
  k = 0; i = 0;
  loop(UI_nreg, (UI_RI[i] == UI_focus_id && UI_RK[i] == 2) ? k = 1; i += 1;);
  k;
);

function sui_focus_kind() local(i, k) (
  k = 0; i = 0;
  loop(UI_nreg, (UI_RI[i] == UI_focus_id) ? k = UI_RK[i]; i += 1;);
  k;
);

function sui_focus_slider() local(i, sl) (
  sl = 0; i = 0;
  loop(UI_nreg, (UI_RI[i] == UI_focus_id) ? sl = UI_RS[i]; i += 1;);
  sl;
);

function sui_focus_editable() local(k, sl) (
  k = sui_focus_kind(); sl = sui_focus_slider();
  (sl > 0) && ((k == 1) || (k == 2));
);

function sui_activate_focus() local(i, k, sl, id) (
  id = UI_focus_id;
  (id >= 6000 && id < 6008) ? (
    UI_sel = id - 6000; UI_sect = 0;
    sui_set_sl(21 + 9 * UI_sel, slider(21 + 9 * UI_sel) >= 0.5 ? 0 : 1);
  ) :
  (id >= 8000 && id < 8008) ? ( UI_sel = id - 8000; UI_sect = 0; ) :
  (
    i = sui_reg_index(id);
    i >= 0 ? (
      k = UI_RK[i]; sl = UI_RS[i];
      (k == 2) ? sui_start_edit(id, sl) :
      (k == 3) ? (
        sl < 0 ? ( UI_showgrid = UI_showgrid ? 0 : 1 ) :
        sl == 92 ? sui_toggle_solo() :
        sui_set_sl(sl, slider(sl) >= 0.5 ? 0 : 1);
      ) :
      (k == 4) ? ( UI_mx = UI_RX[i] + UI_RW[i] * 0.5; UI_my = UI_RY[i] + UI_RH[i] * 0.5; sui_do_menu(id, sl); ) :
      (k == 5) ? sui_page_action(id) : 0;
    ) : 0;
  );
);

function sui_band_db(b, f) local(x, w, d, sh, g, p) (
  d = UI_BD[b]; sh = UI_BS[b];
  x = log(max(f, 1) / UI_BF[b]);
  w = 0.55 / pow(max(UI_BQ[b], 0.1), 0.55);
  sh == 0 ? (
    p = UI_BL[b] * 0.166096404;
    g = UI_BL[b] === sui_slope_db(0.5)
      ? pow((max(f, 1) + 0.0000001) / (0.82501064 * UI_BF[b]), p)
      : pow((max(f, 1) + 0.0000001) / UI_BF[b], p) * 2.42402117;
    g = g / (1 + g);
    g < 0.000001 ? ( g = 0.000001; );
    g = 8.685889638 * log(g);
  ) : sh == 7 ? (
    p = UI_BL[b] * 0.166096404;
    g = UI_BL[b] === sui_slope_db(0.5)
      ? pow((max(f, 1) + 0.0000001) / (1.21210547 * UI_BF[b]), p)
      : pow((max(f, 1) + 0.0000001) / UI_BF[b], p) * 0.41253765;
    g = -8.685889638 * log(1 + g);
  ) : (
    g = sh == 3 ? 0 : d * exp(-0.5 * sqr(x / w));
  );
  g < -24 ? ( g = -24; );
  g > 12 ? ( g = 12; );
  g;
);

function sui_curve_db(f) local(i, g) (
  g = 0; i = 0;
  loop(8, (UI_BU[i] && UI_BE[i]) ? g += sui_band_db(i, f); i += 1;);
  g;
);

function sui_sd_sig() local(i, g) (
  g = 0; i = 0;
  loop(8,
    g = g * 1.2345678901 + UI_BU[i] * 0.71 + UI_BE[i] * 1.37
      + UI_BF[i] * 0.0000137 + UI_BD[i] * 3.11 + UI_BQ[i] * 5.17
      + UI_BS[i] * 7.31 + UI_BL[i] * 11.13;
    i += 1;
  );
  g;
);

function sui_static_update() local(sig, i, g) (
  sig = sui_sd_sig();
  sig == UI_SDSIG ? 0 : (
    UI_SDSIG = sig;
    i = 0;
    while (i < UI_PN) (
      g = sui_curve_db(UI_PF[i]);
      g > 12 ? ( g = 12; );
      g < -12 ? ( g = -12; );
      UI_SD[i] = g;
      i += 1;
    );
  );
);

function sui_curve_cols() local(i, t, i0, i1, fr) (
  i = 0;
  while (i < UI_GW) (
    t = i * (UI_PN - 1) / (UI_GW - 1);
    i0 = floor(t);
    fr = t - i0;
    i1 = i0 + 1;
    i1 >= UI_PN ? ( i1 = UI_PN - 1; );
    UI_CUR[i] = UI_GR_A[i0] * (1 - fr) + UI_GR_A[i1] * fr;
    UI_CUR[i] > 0 ? ( UI_CUR[i] = 0; );
    UI_CUR[i] < -UI_GR_RANGE ? ( UI_CUR[i] = -UI_GR_RANGE; );
    UI_EQ[i] = UI_SD[i0] * (1 - fr) + UI_SD[i1] * fr;
    UI_EQ[i] > 12 ? ( UI_EQ[i] = 12; );
    UI_EQ[i] < -12 ? ( UI_EQ[i] = -12; );
    i += 1;
  );

  UI_PS[0] = 0;
  i = 0;
  while (i < UI_GW) ( UI_PS[i + 1] = UI_PS[i] + UI_CUR[i]; i += 1; );
  i = 0;
  while (i < UI_GW) (
    i0 = i - 2; i0 < 0 ? ( i0 = 0; );
    i1 = i + 2; i1 > UI_GW - 1 ? ( i1 = UI_GW - 1; );
    UI_CUR2[i] = (UI_PS[i1 + 1] - UI_PS[i0]) / (i1 - i0 + 1);
    i += 1;
  );
  UI_PS[0] = 0;
  i = 0;
  while (i < UI_GW) ( UI_PS[i + 1] = UI_PS[i] + UI_CUR2[i]; i += 1; );
  i = 0;
  while (i < UI_GW) (
    i0 = i - 2; i0 < 0 ? ( i0 = 0; );
    i1 = i + 2; i1 > UI_GW - 1 ? ( i1 = UI_GW - 1; );
    UI_CUR3[i] = (UI_PS[i1 + 1] - UI_PS[i0]) / (i1 - i0 + 1);
    i += 1;
  );
);

function sui_gr_range_cycle() (
  UI_GR_RANGE = UI_GR_RANGE === 12 ? 18 : (UI_GR_RANGE === 18 ? 24 : 12);
  UI_GYPX = UI_YPX * 12 / UI_GR_RANGE;
  sui_curve_cols();
  UI_GR_GEN += 1;
);

function sui_curve_update() local(dt, ca, cr, first, i, j, k, k0, k1, m, g,
                                  cur, tgt, co, t, i0, i1, fr, acc, l) (
  dt = UI_now - UI_AN_T;
  first = UI_AN_T < 0;
  first ? ( dt = 0; );
  dt < 0 ? ( dt = 0; );
  dt > 0.5 ? ( dt = 0.5; );
  ca = exp(-dt / 0.010);
  cr = exp(-dt / 0.150);
  UI_GR_ON = (slider98 < 0.5) && (slider97 < 0.5);

  i = 0;
  while (i < UI_PN) (
    k = UI_KS[i];
    m = UI_KP[i];
    g = 8.685889638 * (m3_mm_l[k] + m3_mmp_l[m]);
    cur = 8.685889638 * (m3_mm_r[k] + m3_mmp_r[m]);
    g > cur ? ( g = cur; );
    g < -24 ? ( g = -24; );
    g > 0 ? ( g = 0; );
    first ? ( UI_GR_M[i] = g; UI_GR_H[i] = 0; );
    UI_GR_R[i] = g;
    i += 1;
  );

  i = 0;
  while (i < UI_PN) (
    g = UI_GR_R[i];
    j = i > 1 ? i - 2 : 0;
    l = i < UI_PN - 2 ? i + 2 : UI_PN - 1;
    ((UI_GR_H[i] < 0.5) && (abs(g - UI_GR_M[i]) > 6)
      && (abs(g - 0.5 * (UI_GR_R[j] + UI_GR_R[l])) > 4)) ? (
      UI_GR_H[i] = 1;
      UI_GR_HOLD += 1;
    ) : (
      UI_GR_H[i] = 0;
      UI_GR_M[i] = g;
    );
    i += 1;
  );

  i = 0;
  while (i < UI_PN) (
    j = i > 1 ? i - 2 : 0;
    k = i > 0 ? i - 1 : 0;
    l = i < UI_PN - 1 ? i + 1 : UI_PN - 1;
    m = i < UI_PN - 2 ? i + 2 : UI_PN - 1;
    UI_GR_B[i] = (UI_GR_M[j] + 2 * UI_GR_M[k] + 3 * UI_GR_M[i]
                  + 2 * UI_GR_M[l] + UI_GR_M[m]) * 0.1111111111111111;
    i += 1;
  );

  UI_GR_CHG = 0;
  i = 0;
  while (i < UI_PN) (
    cur = UI_GR_A[i]; tgt = UI_GR_B[i];
