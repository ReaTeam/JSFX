function m3_synthesize(B, N, lm, tap, hsp, win) local(i, j, n2, invn, ph, a) (
  n2 = N / 2;
  invn = 1.0 / N;
  M3B_SPEC[0] = lm[0];
  M3B_SPEC[1] = lm[B - 1];
  i = 1;
  j = 2;
  while (i < B - 1) (
    M3B_SPEC[j] = lm[i];
    M3B_SPEC[j + 1] = 0;
    i += 1;
    j += 2;
  );
  fft_ipermute(M3B_SPEC, n2);
  ifft_real(M3B_SPEC, N);
  i = 0;
  while (i < N) ( M3B_SPEC[i] *= invn; i += 1; );
  i = 1;
  while (i < n2) ( M3B_SPEC[i] *= 2.0; i += 1; );
  i = n2 + 1;
  while (i < N) ( M3B_SPEC[i] = 0; i += 1; );
  fft_real(M3B_SPEC, N);
  fft_permute(M3B_SPEC, n2);
  M3B_OUT[0] = m3_exp(lm[0]);
  M3B_OUT[1] = m3_exp(lm[B - 1]);
  i = 1;
  j = 2;
  while (i < B - 1) (
    ph = M3B_SPEC[j + 1] * 0.5;
    a = m3_exp(lm[i]);
    M3B_OUT[j] = a * cos(ph);
    M3B_OUT[j + 1] = a * sin(ph);
    i += 1;
    j += 2;
  );
  fft_ipermute(M3B_OUT, n2);
  ifft_real(M3B_OUT, N);
  i = 0;
  while (i < B) (
    tap[i] = M3B_OUT[i] * invn * win[i];
    i += 1;
  );
  !LL_ACT ? (
    i = 0;
    while (i < B) ( M3B_OUT[i] = tap[i]; i += 1; );
    while (i < N) ( M3B_OUT[i] = 0; i += 1; );
    fft_real(M3B_OUT, N);
    fft_permute(M3B_OUT, n2);
    i = 0;
    while (i < N) ( hsp[i] = M3B_OUT[i] * 0.5; i += 1; );
  );
);

function linph_spectrum(B, F, kr, lm, hsp, tb, fb) local(li, lj, lh, lq, ln, linv, lidx, lw) (
  lh = F / 2;
  lq = lh / 2;
  ln = kr * F;
  linv = 1.0 / F;
  tb[0] = exp(lm[0]);
  tb[1] = exp(lm[B - 1]);
  li = 1;
  lj = 2;
  while (li < B - 1) (
    tb[lj] = exp(lm[li]);
    tb[lj + 1] = 0;
    li += 1;
    lj += 2;
  );
  fft_ipermute(tb, lh);
  ifft_real(tb, F);
  memset(fb, 0, ln);
  li = 0;
  while (li < lh) (
    lidx = li - lq;
    lidx < 0 ? ( lidx += F; );
    lw = 0.5 * (1.0 - cos(PI2 * li / lh));
    fb[kr * li] = tb[lidx] * linv * lw;
    li += 1;
  );
  fft_real(fb, ln);
  fft_permute(fb, ln / 2);
  li = 0;
  while (li < ln) ( hsp[li] = fb[li] * 0.5; li += 1; );
);

function ll_reset() (
  memset(LL_BASE, 0, LL_END - LL_BASE);
  LL_SBANK = 0; LL_SPREV = 0; LL_SPUB = 0; LL_SHOP = 0; LL_SSEEN = 0; LL_SWHOP = 0;
  LL_PBANK = 0; LL_PPREV = 0; LL_PPUB = 0; LL_PHOP = 0; LL_PSEEN = 0; LL_PWHOP = 0;
);

function ll_begin(bank, pub, seen, nb, split, nn, hop, nr, hmask) (
  LLG_BANK = pub > 0 ? 1 - bank : 0;
  LLG_PREV = pub > 0 ? bank : 0;
  LLG_OUT = (LLG_BANK ? (seen & 2) : (seen & 1)) ? LLG_BANK : (pub > 0 ? LLG_PREV : -1);
  LLG_CNT = LLG_PREV == LLG_BANK ? 1 : 2;
  LLG_B = nb;
  LLG_H = 2 * KK * split;
  LLG_SPLIT = split;
  LLG_YB = KK * split;
  LLG_N = nn;
  LLG_HOP = hop;
  LLG_R = nr;
  LLG_HMASK = hmask;
);

function ll_cmul(fa, fb, nn) local(ldc, lny) (
  ldc = fa[0] * fb[0];
  lny = fa[1] * fb[1];
  convolve_c(fa, fb, nn / 2);
  fa[0] = ldc;
  fa[1] = lny;
);

function ll_hcopy(dst, hist, t, len, mask) local(lo, la) (
  lo = t & mask;
  la = min(len, mask + 1 - lo);
  memcpy(dst, hist + lo, la);
  la < len ? ( memcpy(dst + la, hist, len - la); );
);

function ll_publish(src, tp, cp, yp, dp, xp, gp, hist, fa, fb)
  local(li, lj, lq, llo, lwd, lnr, lr, ltb, lcb, linv, lb, lk, lyb, lp, lx, lspan, lg)
(
  ltb = tp + LLG_BANK * LLG_B;
  lcb = cp + LLG_BANK * LLG_H;
  linv = 1.0 / (4 * LLG_N);
  memset(lcb, 0, 2 * LLG_HOP);
  LLG_OUT >= 0 ? (
    lj = tp + LLG_OUT * LLG_B;
    li = 0;
    while (li < LLG_B) ( dp[li] = lj[li] - src[li]; li += 1; );
    lp = 0;
    while (lp < KK) (
      lj = smp_t + lp - KK;
      lx = xp + (lj & LL_KM) * 2 * LLG_R;
      lq = LLG_R - 1 - ((lj >> LL_KSH) & (LLG_R - 1));
      llo = 0;
      lwd = 32;
      while (llo < 256) (
        lnr = min(KK * (lwd - 1), 2 * LLG_HOP);
        lr = 0;
        while (KK * lr + lp < lnr) (
          lcb[KK * lr + lp] += mem_multiply_sum(dp + llo + lr + 1, lx + lq + llo, lwd - 1 - lr);
          lr += 1;
        );
        llo += lwd;
        lwd = llo < 64 ? 32 : llo;
      );
      lp += 1;
    );
    LLG_B > 257 ? (
      llo = 256;
      lwd = LLG_B - 257;
      lspan = KK * (lwd - 1);
      ll_hcopy(fa, hist, smp_t - KK * llo - lspan, lspan + 1, LLG_HMASK);
      memset(fa + lspan + 1, 0, LLG_N - lspan - 1);
      fft_real(fa, LLG_N);
      fft_permute(fa, LLG_N / 2);
      memset(fb, 0, LLG_N);
      KK == 1 ? (
        memcpy(fb, dp + llo, lwd);
      ) : (
        li = 0;
        while (li < lwd) ( fb[KK * li] = dp[llo + li]; li += 1; );
      );
      fft_real(fb, LLG_N);
      fft_permute(fb, LLG_N / 2);
      ll_cmul(fa, fb, LLG_N);
      fft_ipermute(fa, LLG_N / 2);
      ifft_real(fa, LLG_N);
      lnr = min(lspan, 2 * LLG_HOP);
      lr = 0;
      while (lr < lnr) ( lcb[lr] += fa[lr + lspan] * linv; lr += 1; );
    );
  );
  memcpy(ltb, src, LLG_B);
  KK == 1 ? (
    ll_hcopy(fa, hist, smp_t - LLG_N, LLG_N, LLG_HMASK);
  ) : (
    lk = LLG_N - KK * LLG_SPLIT;
    ll_hcopy(fa, hist, smp_t - lk, lk, LLG_HMASK);
    memset(fa + lk, 0, LLG_N - lk);
  );
  fft_real(fa, LLG_N);
  fft_permute(fa, LLG_N / 2);
  lg = gp + LLG_BANK * LLG_N;
  memset(lg, 0, LLG_N);
  KK == 1 ? (
    memcpy(lg, ltb + LLG_SPLIT, LLG_B - LLG_SPLIT);
  ) : (
    li = 0;
    while (li < LLG_B) ( lg[KK * li] = ltb[li]; li += 1; );
  );
  fft_real(lg, LLG_N);
  fft_permute(lg, LLG_N / 2);
  lk = 0;
  while (lk < LLG_CNT) (
    lb = (lk == 0) ? LLG_PREV : LLG_BANK;
    memcpy(fb, fa, LLG_N);
    ll_cmul(fb, gp + lb * LLG_N, LLG_N);
    fft_ipermute(fb, LLG_N / 2);
    ifft_real(fb, LLG_N);
    lyb = yp + lb * LLG_YB;
    lj = LLG_N - KK * LLG_SPLIT;
    li = 0;
    while (li < LLG_HOP) ( lyb[li] = fb[lj + li] * linv; li += 1; );
    lk += 1;
  );
);

function ll_weights(wt, hop, whop) local(li) (
  hop != whop ? (
    li = 0;
    while (li < hop) ( wt[li] = 0.5 * (1.0 - cos(PI2 * 0.5 * li / hop)); li += 1; );
  );
  hop;
);

function ll_view(bank, prev, hop, pub, nb, split, wt, q) (
  LLV_M = (smp_t - 1) & (hop - 1);
  LLV_W = wt[LLV_M];
  LLV_Q = q;
  LLV_SPLIT = KK == 1 ? split : (LLV_M >> LL_KSH) + 1;
  LLV_PUB = pub;
  LLV_TB = bank * nb;
  LLV_TP = prev * nb;
  LLV_CB = bank * 2 * KK * split + LLV_M;
  LLV_CP = prev * 2 * KK * split + hop + LLV_M;
  LLV_YB = bank * KK * split + LLV_M;
  LLV_YP = prev * KK * split + LLV_M;
);

function ll_out(xin, tp, cp, yp, xp) local(luc, lup) (
  luc = mem_multiply_sum(tp + LLV_TB, xp + LLV_Q, LLV_SPLIT) + cp[LLV_CB] + yp[LLV_YB];
  LLV_PUB <= 1 ? (
    (1 - LLV_W) * xin + LLV_W * luc;
  ) : (
    lup = mem_multiply_sum(tp + LLV_TP, xp + LLV_Q, LLV_SPLIT) + cp[LLV_CP] + yp[LLV_YP];
    (1 - LLV_W) * lup + LLV_W * luc;
  );
);

function commit_frame(hbase, fbase, abase, wn, hsize, fsize, hmask, amask, sg, hsp) local(i, idx, start, sr, si, hr, hi, fco, r, j)
(
  start = smp_t - hsize;
  memset(fbase, 0, fsize);
  i = 0;
  while (i < hsize) (
    idx = start + i;
    idx >= 0 ? ( fbase[i] = hbase[idx & hmask] * wn[i]; );
    i += 1;
  );
  fft_real(fbase, fsize);
  fft_permute(fbase, fsize / 2);
  (m3_apply || LINPH_ON) ? (
    ((KK > 1) && (LINPH_ON == 0)) ? (
      fco = fsize / KK;
      i = 0;
      while (i <= fsize / 2) (
        r = i;
        while (r >= fco) ( r -= fco; );
        r == 0 ? (
          hr = hsp[0];
          hi = 0;
        ) : (
          r == fco / 2 ? (
            hr = hsp[1];
            hi = 0;
          ) : (
            r < fco / 2 ? (
              hr = hsp[2 * r];
              hi = hsp[2 * r + 1];
            ) : (
              j = fco - r;
              hr = hsp[2 * j];
              hi = -hsp[2 * j + 1];
            );
          );
        );
        sr = fbase[2 * i];
        si = fbase[2 * i + 1];
        fbase[2 * i] = sr * hr - si * hi;
        fbase[2 * i + 1] = sr * hi + si * hr;
        i += 1;
      );
    ) : (
      fbase[0] *= hsp[0];
      fbase[1] *= hsp[1];
      i = 1;
      while (i < fsize / 2) (
        sr = fbase[2 * i];
        si = fbase[2 * i + 1];
        hr = hsp[2 * i];
        hi = hsp[2 * i + 1];
        fbase[2 * i] = sr * hr - si * hi;
        fbase[2 * i + 1] = sr * hi + si * hr;
        i += 1;
      );
    );
  );
  fft_ipermute(fbase, fsize / 2);
  ifft_real(fbase, fsize);
  i = 0;
  while (i < fsize) (
    idx = start + i;
    idx >= 0 ? ( abase[idx & amask] += sg * fbase[i]; );
    i += 1;
  );
);

function front_frame(ring, dring, hsize, fsize, B, wn, tab, out) local(i, idx, re, im, K, acc, prev, cur, ratio, JFR, j, i0, n1) (
  memset(SFFT + hsize, 0, fsize - hsize);
  KK > 1 ? (
    JFR = floor(smp_t / KK);
    i0 = hsize - JFR;
    i0 < 0 ? ( i0 = 0; );
    i = 0;
    while (i < i0) ( SFFT[i] = 0; i += 1; );
    j = (JFR - hsize + i0) & 4095;
    n1 = 4096 - j;
    n1 > hsize - i0 ? ( n1 = hsize - i0; );
    n1 = n1 + i0;
    while (i < n1) ( SFFT[i] = dring[j] * wn[i]; j += 1; i += 1; );
    j = 0;
    while (i < hsize) ( SFFT[i] = dring[j] * wn[i]; j += 1; i += 1; );
  ) : (
    i0 = hsize - smp_t;
    i0 < 0 ? ( i0 = 0; );
    i = 0;
    while (i < i0) ( SFFT[i] = 0; i += 1; );
    j = (smp_t - hsize + i0) & 8191;
    n1 = 8192 - j;
    n1 > hsize - i0 ? ( n1 = hsize - i0; );
    n1 = n1 + i0;
    i = i0;
    while (i < n1) ( SFFT[i] = ring[j] * wn[i]; j += 1; i += 1; );
    j = 0;
    while (i < hsize) ( SFFT[i] = ring[j] * wn[i]; j += 1; i += 1; );
  );
  fft_real(SFFT, fsize);
  fft_permute(SFFT, fsize / 2);
  out[0] = abs(SFFT[0]) * 0.5;
  out[B - 1] = abs(SFFT[1]) * 0.5;
  i = 1;
  idx = 2;
  while (i < B - 1) (
    re = SFFT[idx];
    im = SFFT[idx + 1];
    out[i] = sqrt(re * re + im * im) * 0.5;
    idx += 2;
    i += 1;
  );
  K = B >> 2;
  acc = 0;
  prev = out[0];
  i = 1;
  while (i < K) (
    cur = out[i];
    acc += abs(cur - prev) / (prev + 0.0000001);
    prev = cur;
    i += 1;
  );
  ratio = acc / K;
  ratio < 0.001 ? (
    i = 0;
    while (i < B) ( out[i] *= ratio; i += 1; );
  );
  m3_mode == 0 ? (
    i = 0;
    while (i < B) ( out[i] *= tab[i]; i += 1; );
  );
  ratio;
);

function apply_floor(ml, mr, B) local(k, s, tL, tR, v) (
  s = 0;
  k = 0;
  while (k < 32) ( s += ml[k] * W32[k]; k += 1; );
  tL = s * 0.3548133892335754;
  s = 0;
  k = 0;
  while (k < 32) ( s += (mr[k] - tL) * W32[k]; k += 1; );
  tR = s * 0.3548133892335754;
  FLOOR_L = tL;
  FLOOR_R = tR;
  k = 0;
  while (k < B) (
    v = ml[k] - tL - tR;
    ml[k] = v < 0 ? 0 : v;
    v = mr[k] - tL - tR;
    mr[k] = v < 0 ? 0 : v;
    k += 1;
  );
);

function apply_floor_peak(ml, mr, B) local(k, pk, fl) (
  pk = ml[0];
  k = 1;
  while (k < B) ( ml[k] > pk ? ( pk = ml[k]; ); k += 1; );
  k = 0;
  while (k < B) ( mr[k] > pk ? ( pk = mr[k]; ); k += 1; );
  fl = pow(10, (m3_detail * 20 - 60) * 0.05000000074505806) * pk;
  FLOOR_L = fl;
  FLOOR_R = fl;
  k = 0;
  while (k < B) (
    ml[k] < fl ? ( ml[k] = fl; );
    mr[k] < fl ? ( mr[k] = fl; );
    k += 1;
  );
);

function m3_rebuild_static() (
  m3_axis = m3_axs;
  m3_build_axis(m3_axs, SB, SH);
  m3_build_strength(m3_w3s, SB, SH);
  m3_rowstride = PB;
  m3_build_maps(SB, SH, m3_reds, m3_exps, m3_msts, m3_mlns);
  m3_build_w358(m3_w358s, SB, SF);
  m3_axis = m3_axp;
  m3_build_axis(m3_axp, PB, PH);
  m3_build_strength(m3_w3p, PB, PH);
  m3_rowstride = PB;
  m3_build_maps(PB, PH, m3_redp, m3_expp, m3_mstp, m3_mlnp);
  m3_build_w358(m3_w358p, PB, PF);
);

function m3_solo_k() (
  floor(8 * m3_clip01(slider92) + 0.5);
);

function m3_solo_build() local(k, j, i, sh, f, w, q, u, g, mx) (
  k = m3_solo_k();
  k > 0 ? (
    j = k - 1;
    sh = m3_bsh[j];
    q = m3_bq[j];
    q = q > 0 ? q : 1.0;
    mx = 0;
    i = 0;
    while (i < PB) (
      f = m3_axp[i];
      (sh === 0) || (sh === 7) ? (
        w = 1.0 - m3_band_kernel(j, f);
      ) : (sh === 3) ? (
        w = 1.0;
      ) : (
        u = (m3_bf[j] > 0) ? log((f + M3_EPS) / m3_bf[j]) * M3_LOG2E / (q * M3_BELL_W) : 0;
        g = exp(-0.5 * u * u);
        w = g * g;
        w = w * w;
      );
      SOLO_W[i] = w;
      w > mx ? ( mx = w; );
      i += 1;
    );
    mx = mx > 0 ? 1.0 / mx : 1.0;
    i = 0;
    while (i < PB) (
      w = SOLO_W[i] * mx;
      SOLO_W[i] = log(w > 0.001 ? w : 0.001);
      i += 1;
    );
  );
);

function m3_solo_apply() local(i) (
  i = 0;
  while (i < PB) (
    SOLO_ML[i] = m3_mmp_l[i] + SOLO_W[i];
    SOLO_MR[i] = m3_mmp_r[i] + SOLO_W[i];
    i += 1;
  );
);

function m3_rebuild_tables() local(i) (
  m3_detail = m3_clip01(slider6);
  m3_mode = slider3 >= 0.5 ? 1 : 0;
  m3_link_amt = m3_clip01(slider18);
  m3_focus = m3_clip01(slider19);
  m3_maxcut = slider93 >= 0.999 ? 60.0 : 24.0 * m3_clip01(slider93);
  m3_cutoff = log(pow(10, m3_maxcut * M3_CUT_SCALE));
  m3_bal_l = m3_clip01(2.0 * (1.0 - m3_focus));
  m3_bal_r = m3_clip01(2.0 * m3_focus);
  m3_tl = m3_tilt_gain(slider9);
  m3_th = m3_tilt_gain(slider10);
  m3_atl = m3_tilt_gain(slider11);
  m3_ath = m3_tilt_gain(slider12);
  m3_rtl = m3_tilt_gain(slider13);
  m3_rth = m3_tilt_gain(slider14);
  m3_strength = m3_calc_strength(m3_clip01(slider1), m3_detail);
  m3_mode == 1 ? ( m3_strength = m3_calc_strength1(m3_clip01(slider1), m3_detail); );
  m3_gain1 = -0.25 - pow(m3_detail, 4) * 0.25;
  m3_dirty_static ? ( m3_rebuild_static(); m3_dirty_static = 0; m3_dirty_band_mask = 255; m3_dirty_w9 = 1; m3_dirty_temporal = m3_dirty_temporal | 63; );
  m3_dirty_bands ? ( m3_set_bands(); );
  m3_axis = m3_axs;
  m3_dirty_w9 ? ( m3_build_detail(m3_w9s, SB); );
  m3_dirty_bands ? (
    m3_bands_update(m3_w8sl, m3_w8sr, m3_fwsl, m3_fwsr, SB);
  );
  (m3_dirty_w9 || m3_dirty_detail || m3_dirty_mode) ? (
    m3_build_selectivity(m3_w4s, SB, SH, m3_detail);
    m3_apply_detail(m3_w4s, m3_w9s, SB, 1);
  );
  (m3_dirty_detail || m3_dirty_tilt) ? (
    m3_build_tilt(m3_w6s, SB, m3_detail_tilt_level(m3_detail));
  );
  m3_dirty_temporal ? (
    m3_build_temporal(SB, SH, m3_detail, slider7, slider8, m3_tcs, m3_tcas, m3_tcbs, m3_wbs, m3_wcs, m3_wes, m3_wds);
  );
  (m3_dirty_w9 || m3_dirty_detail || m3_dirty_tilt) ? (
    m3_build_filters(SB, SH, m3_w6s, m3_w9s, m3_m15s, m3_m20s, m3_detail_shape(m3_detail));
  );
  m3_axis = m3_axp;
  m3_dirty_w9 ? ( m3_build_detail(m3_w9p, PB); );
  m3_dirty_bands ? (
    m3_bands_update(m3_w8pl, m3_w8pr, m3_fwpl, m3_fwpr, PB);
  );
  (m3_dirty_w9 || m3_dirty_detail || m3_dirty_mode) ? (
    m3_build_selectivity(m3_w4p, PB, PH, m3_detail);
    m3_apply_detail(m3_w4p, m3_w9p, PB, 0);
  );
  (m3_dirty_detail || m3_dirty_tilt) ? (
    m3_build_tilt(m3_w6p, PB, m3_detail_tilt_level(m3_detail));
  );
  m3_dirty_temporal ? (
    m3_build_temporal(PB, PH, m3_detail, slider7, slider8, m3_tc, m3_tca, m3_tcb, m3_wbp, m3_wcp, m3_wep, m3_wdp);
  );
  (m3_dirty_w9 || m3_dirty_detail || m3_dirty_tilt) ? (
    m3_build_filters(PB, PH, m3_w6p, m3_w9p, m3_m15p, m3_m20p, m3_detail_shape(m3_detail));
  );
  (m3_dirty_bands || m3_dirty_solo) ? ( m3_solo_build(); m3_dirty_solo = 0; );
  m3_dirty_w9 = 0;
  m3_dirty_bands = 0;
  m3_dirty_detail = 0;
  m3_dirty_mode = 0;
  m3_dirty_tilt = 0;
  m3_dirty_temporal = 0;
  m3_dirty_band_mask = 0;
);

function params_sync() (
  SC_ON = slider15 >= 0.5;
  MS_ON = slider17 >= 0.5;
  QIDX = floor(slider4 * 2.0 + 0.5);
  QIDX < 0 ? ( QIDX = 0; );
  QIDX > 2 ? ( QIDX = 2; );
  QDIV = (QIDX >= 2) ? 8 : ((QIDX >= 1) ? 4 : 2);
  SHOP = SH / QDIV;
  PHOP = PH / QDIV;
  SHOPR = KK * SHOP;
  PHOPR = KK * PHOP;
  SSG = (1.0 / QDIV) / (2.0 * SN);
  PSG = (1.0 / QDIV) / (2.0 * PN);
  m3_apply = (m3_clip01(slider1) > 0.0) || (m3_solo_k() > 0);
);

function params_track() local(ch, v, i, m, s, r) (
  ch = 0;
  r = 0;
  loop(NSL,
    i = SLN[r] - 1;
    v = slider(i + 1);
    v != SPV[i] ? (
      ch = 1;
      m = SDM[i];
      (m & 255) ? ( m3_dirty_bands = 1; m3_dirty_band_mask = m3_dirty_band_mask | (m & 255); );
      (m & 16128) ? ( m3_dirty_temporal = m3_dirty_temporal | ((m >> 8) & 63); );
      (m & 16384) ? ( m3_dirty_mode = 1; );
      (m & 32768) ? ( m3_dirty_detail = 1; );
      (m & 65536) ? ( m3_dirty_tilt = 1; );
      (m & 131072) ? ( m3_bandcfg = 1; );
      (m & 262144) ? ( m3_dirty_w9 = 1; );
      (m & 524288) ? ( m3_dirty_solo = 1; );
      s = m >> 20;
      (s > 0) ? (
        (m3_shape_bell(SPV[s]) || m3_shape_bell(slider(s + 1))) ? ( m3_dirty_w9 = 1; );
      );
    );
    SPV[i] = v;
    r += 1;
  );
  (m3_dirty_bands || m3_bandcfg || !m3_audio_on) ? (
    (slider3 >= 0.5 ? 1 : 0) !== m3_band_mode ? (
      m3_band_mode = slider3 >= 0.5 ? 1 : 0;
      m3_dirty_bands = 1;
      m3_dirty_band_mask = 255;
      ch = 1;
    );
  );
  m3_bandcfg = 0;
  ch;
);

SDM[0] = 131072;
SDM[2] = 16384 + 63 * 256;
SDM[3] = 60 * 256;
SDM[5] = 131072 + 32768 + 12 * 256;
SDM[6] = 16 * 256;
SDM[7] = 32 * 256;
SDM[8] = 65536;
SDM[9] = 65536;
SDM[10] = 18 * 256;
SDM[11] = 18 * 256;
SDM[12] = 34 * 256;
SDM[13] = 34 * 256;
sdm_j = 19;
sdm_k = 1;
loop(8,
  SDM[sdm_j] = sdm_k + 262144;
  SDM[sdm_j + 1] = sdm_k + 262144;
  SDM[sdm_j + 2] = sdm_k + (sdm_j + 8) * 1048576;
  SDM[sdm_j + 3] = sdm_k + (sdm_j + 8) * 1048576;
  SDM[sdm_j + 4] = sdm_k + (sdm_j + 8) * 1048576;
  SDM[sdm_j + 5] = sdm_k;
  SDM[sdm_j + 6] = sdm_k;
  SDM[sdm_j + 8] = sdm_k + 262144;
  sdm_j += 9;
  sdm_k *= 2;
);
SDM[92] = 131072;
SDM[91] = 524288;

m3_audio_on = 0;
m3_band_mode = slider3 >= 0.5 ? 1 : 0;
params_track();
m3_dirty_static = 1;
m3_dirty_bands = 1;
m3_dirty_band_mask = 255;
m3_dirty_w9 = 1;
m3_dirty_detail = 1;
m3_dirty_mode = 1;
m3_dirty_tilt = 1;
m3_dirty_temporal = 63;
m3_rebuild_tables();
m3_tbl_dirty = 0;
m3_apply = (m3_clip01(slider1) > 0.0) || (m3_solo_k() > 0);

smp_t = 0;
SC_ON = slider15 >= 0.5;
MS_ON = slider17 >= 0.5;
LINPH_ON = slider5 >= 0.5;
LINPH_RST = 0;
LL_ON = slider2 >= 0.5;
LL_ACT = LL_ON;
LL_RST = 0;
ll_reset();

function ser_get(sv, sd) (
  (sv - sv) >= 0.0 ? ((sv < 0.0) ? 0.0 : ((sv > 1.0) ? 1.0 : sv)) : sd;
);

function ser_def(sl) local(sdb, sdo) (
