UI_win_w = gfx_w; UI_win_h = gfx_h;
UI_fit = min(UI_win_w / UI_DW, UI_win_h / UI_DH);
UI_s = max(UI_fit, 1.0);
UI_z = min(UI_s, 1.70);
UI_bsc = UI_s / UI_z;
UI_bw = floor(UI_DW * UI_z); UI_bh = floor(UI_DH * UI_z);
UI_layw = floor(UI_bw * UI_bsc + 0.5); UI_layh = floor(UI_bh * UI_bsc + 0.5);

UI_ovx = (UI_layw > UI_win_w);
UI_ovy = (UI_layh > UI_win_h);
UI_SBW = UI_ovy ? 4 : 0;
UI_SBH = UI_ovx ? 4 : 0;
(UI_layw > UI_win_w - UI_SBW) ? ( UI_SBH = 4; );
(UI_layh > UI_win_h - UI_SBH) ? ( UI_SBW = 4; );
UI_ovx = (UI_layw > UI_win_w - UI_SBW);
UI_ovy = (UI_layh > UI_win_h - UI_SBH);
UI_vw = UI_ovx ? (UI_win_w - UI_SBW) : UI_layw;
UI_vh = UI_ovy ? (UI_win_h - UI_SBH) : UI_layh;
UI_MAXSX = max(0, UI_layw - UI_vw);
UI_MAXSY = max(0, UI_layh - UI_vh);
UI_SX = min(max(UI_SX, 0), UI_MAXSX);
UI_SY = min(max(UI_SY, 0), UI_MAXSY);
UI_dx = (UI_MAXSX > 0) ? 0 : floor((UI_win_w - UI_SBW - UI_layw) * 0.5);
UI_dy = (UI_MAXSY > 0) ? 0 : floor((UI_win_h - UI_SBH - UI_layh) * 0.5);

UI_mx = sui_mapx(mouse_x);
UI_my = sui_mapy(mouse_y);
UI_now = time_precise();
UI_md = mouse_cap & 1;
UI_rd = mouse_cap & 2;
UI_md_edge = UI_md && !UI_last_md;
UI_rd_edge = UI_rd && !UI_last_rd;
UI_ch = gfx_getchar();
UI_shift = (mouse_cap & 8) ? 1 : 0;
UI_ctrl  = (mouse_cap & 4) ? 1 : 0;
UI_alt   = (mouse_cap & 16) ? 1 : 0;
UI_ab_flash_on = (UI_now - UI_ab_flash_t) < 0.25;

UI_wd = mouse_wheel; UI_hd = mouse_hwheel;
mouse_wheel = 0; mouse_hwheel = 0;
abs(UI_wd) >= 20 ? ( UI_wd = UI_wd / 120; );
abs(UI_hd) >= 20 ? ( UI_hd = UI_hd / 120; );
(UI_wgest && (UI_now - UI_wt > 0.4)) ? sui_gest_end_wheel() : 0;

UI_mu_edge = (!UI_md && UI_last_md);
UI_mu_edge && UI_gest && !UI_wgest ? (
  UI_gest_dirty ? (
    sui_touch_end();
    ((UI_drag_kind == 1) && (abs(UI_mx - UI_drag_x0) <= 2)) ?
      ( UI_defer = 1; UI_defer_t = UI_now; ) : sliderchange(-1);
  ) : 0;
  UI_gest = 0; UI_gest_dirty = 0;
) : 0;
(!UI_gest && UI_pend) ? sui_undo_flush() : 0;
(UI_defer && !UI_md && !UI_gest && (UI_now - UI_defer_t > 0.33)) ? sui_defer_flush() : 0;

UI_i = 0;
loop(8,
  UI_BU[UI_i] = slider(20 + 9 * UI_i) >= 0.5;
  UI_BE[UI_i] = slider(21 + 9 * UI_i) >= 0.5;
  UI_BF[UI_i] = sui_n2f(sui_clamp01(slider(22 + 9 * UI_i)));
  UI_BD[UI_i] = 24 * sui_clamp01(slider(23 + 9 * UI_i)) - 12;
  UI_BQ[UI_i] = sui_qval(sui_clamp01(slider(24 + 9 * UI_i)));
  UI_BS[UI_i] = sui_shape_snap(slider(28 + 9 * UI_i));
  UI_BL[UI_i] = sui_slope_db(sui_clamp01(slider(25 + 9 * UI_i)));
  UI_i += 1;
);
sui_static_update();

UI_i = 0;
loop(8,
  UI_t = log(max(UI_BF[UI_i], 1) / 20) / 6.907755278982137 * (UI_PN - 1);
  UI_t < 0 ? ( UI_t = 0; );
  UI_t > UI_PN - 2 ? ( UI_t = UI_PN - 2; );
  UI_p = floor(UI_t); UI_fr = UI_t - UI_p;
  UI_NDY[UI_i] = UI_SD[UI_p] * (1 - UI_fr) + UI_SD[UI_p + 1] * UI_fr;
  UI_i += 1;
);

(UI_AN_T < 0) || (UI_now - UI_AN_T >= 0.012) ? sui_curve_update();

UI_HITR = max(16, 10 / UI_z);
UI_hov_band = -1;
sui_hit(UI_GX, UI_GY, UI_GW, UI_GH) ? (
  UI_bestd = sqr(UI_HITR); UI_i = 0;
  loop(8,
    UI_BU[UI_i] ? (
      UI_nx = sui_f2x(UI_BF[UI_i]); UI_ny = UI_MIDY - UI_NDY[UI_i] * UI_YPX;
      UI_dd = sqr(UI_mx - UI_nx) + sqr(UI_my - UI_ny);
      UI_dd < UI_bestd ? ( UI_hov_band = UI_i; UI_bestd = UI_dd; );
    ) : 0;
    UI_i += 1;
  );
);

UI_hv = sui_wheel_hit();
UI_hv_id = (UI_hv >= 0) ? UI_RI[UI_hv] : -1;
UI_hv_kind = (UI_hv >= 0) ? UI_RK[UI_hv] : 0;
UI_hv_sl = (UI_hv >= 0) ? UI_RS[UI_hv] : 0;
(UI_hov_band >= 0) ? (
  UI_hv_id = 6000 + UI_hov_band; UI_hv_kind = 8; UI_hv_sl = 0;
) : (UI_hv_id < 0) ? (
  UI_i = 0; UI_rr = -1;
  loop(8,
    (UI_rr < 0 && sui_hit(13, UI_LY + UI_i * UI_LP, UI_LW, UI_LP - 1)) ? UI_rr = UI_i;
    UI_i += 1;
  );
  UI_rr >= 0 ? ( UI_hv_id = 8000 + UI_rr; UI_hv_kind = 7; UI_hv_sl = 0; );
  (UI_rr < 0 && sui_hit(UI_GRL_X, UI_GRL_Y, UI_GRL_W, UI_GRL_H)) ? (
    UI_hv_id = 1902; UI_hv_kind = 9; UI_hv_sl = 0;
  ) : 0;
) : 0;
(UI_hv_id != UI_last_hv_id) ? (
  UI_last_hv_id = UI_hv_id; UI_hov_t = UI_now;
  (UI_hv_id >= 0 && !UI_md && !UI_drag && (UI_edit_id < 0) && (UI_ch == 0)) ? (
    UI_focus_id = UI_hv_id; UI_focus_kb = 0;
  ) : 0;
) : 0;

(UI_wd != 0 || UI_hd != 0) ? (
  UI_wctl = -1; UI_wsl = 0;
  (UI_hov_band >= 0) ? (
    UI_wctl = -2;
    UI_wsl = sui_slope_shape(UI_BS[UI_hov_band]) ?
      22 + 9 * UI_hov_band : 23 + 9 * UI_hov_band;
