function m3_build_strength(dst, B, H) local(i, center, ex, L, x) (
  center = (H == 256) ? 3000.0 : 2000.0;
  ex = (H == 256) ? 2.0 : 3.0;
  L = log(pow(10, 0.05 * ex));
  i = 0;
  while (i < B) (
    x = (m3_axis[i] + M3_EPS) / center;
    x = m3_log(x) * M3_LOG2E_F;
    x = x * x * M3_STRENGTH_SCALE;
    x = m3_exp(x);
    x = m3_exp(x * L);
    dst[i] = x;
    i += 1;
  );
);

function m3_build_selectivity(dst, B, H, detail) local(i, q, top, fc, inv, x, v, small) (
  small = (H == 256);
  q = m3_clip01(detail * detail);
  top = (m3_mode == 1) ? 16000.0 : 6000.0;
  fc = exp(log(1000.0) + q * (log(top) - log(1000.0)));
  inv = 1.0 / m3_max(fc, M3_EPS);
  i = 0;
  while (i < B) (
    x = (m3_axis[i] + M3_EPS) * inv;
    x = x * x * x;
    v = 1.0 / (1.0 + x);
    v = m3_clip01(v);
    dst[i] = small ? (1.0 - v) : v;
    i += 1;
  );
