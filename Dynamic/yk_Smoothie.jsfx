  i = 0;
  !on ? (
    while (i < B) ( dl[i] = 1.0; dr[i] = 1.0; i += 1; );
  ) : w0 == w1 ? (
    while (i < B) ( dl[i] = m3_band_kernel(j, m3_axis[i]); i += 1; );
    memcpy(dr, dl, B);
  ) : (
    pa = w0 >= 0.01;
    pb = w1 >= 0.01;
    pc = w0 <= 0.99;
    pd = w1 <= 0.99;
    while (i < B) (
      ker = m3_band_kernel(j, m3_axis[i]);
      dl[i] = pa ? (pc ? pow(ker, w0) : ker) : 1.0;
      dr[i] = pb ? (pd ? pow(ker, w1) : ker) : 1.0;
      i += 1;
    );
  );
);

function m3_band_product(dst, fac, B) local(i, v, o1, o2, o3, o4, o5, o6, o7) (
  o1 = B; o2 = 2 * B; o3 = 3 * B; o4 = 4 * B;
  o5 = 5 * B; o6 = 6 * B; o7 = 7 * B;
  i = 0;
  while (i < B) (
    v = fac[i];
    v = v * fac[o1 + i];
    v = v * fac[o2 + i];
    v = v * fac[o3 + i];
    v = v * fac[o4 + i];
    v = v * fac[o5 + i];
    v = v * fac[o6 + i];
    v = v * fac[o7 + i];
    dst[i] = v;
    i += 1;
  );
);

function m3_bands_update(dl, dr, fl, fr, B) local(j, bit, sym, w0, w1) (
  bit = 1;
  j = 0;
  sym = 1;
  while (j < 8) (
    (m3_dirty_band_mask & bit) ? (
      m3_band_factor(fl + j * B, fr + j * B, B, j);
    );
    (m3_bu[j] && m3_be[j] && m3_bsh[j] != 3) ? (
      w0 = m3_clip01(2.0 * (1.0 - m3_bfo[j]));
      w1 = m3_clip01(2.0 * m3_bfo[j]);
      w0 != w1 ? ( sym = 0; );
    );
    bit = bit * 2;
    j += 1;
  );
  m3_band_product(dl, fl, B);
  sym ? ( memcpy(dr, dl, B); ) : ( m3_band_product(dr, fr, B); );
);

function m3_build_detail(dst, B) local(j, i, base, amp, gain, A, width, invc, f, u, g) (
  i = 0;
  while (i < B) ( dst[i] = 1.0; i += 1; );
  j = 0;
  while (j < 8) (
    (m3_bu[j] && m3_be[j] && (m3_bsh[j] == 2 || m3_bsh[j] == 3) &&
        m3_bd[j] > 0 && m3_bq[j] > 0 && m3_bf[j] > 0) ? (
      base = m3_bq[j];
      amp = pow(base, -0.7) - 1.0;
      amp < 0 ? ( amp = 0; );
      gain = m3_min(6.0, m3_bd[j] * 2.0);
      amp = amp * gain;
      (amp > 0) ? (
        A = log(pow(10, 0.05 * amp));
        width = base * 2.0 * M3_BELL_W;
        invc = 1.0 / m3_bf[j];
        i = 0;
        while (i < B) (
          f = m3_axis[i];
          u = log((f + M3_EPS) * invc) * M3_LOG2E;
          g = exp(-0.5 * (u / width) * (u / width));
          dst[i] = dst[i] * exp(A * g);
          i += 1;
        );
      );
    );
    j += 1;
  );
);

function m3_shape_child(dst, B, center, slope, gain) local(i, k, invc, y) (
  k = slope * M3_SIXTH;
  invc = 1.0 / m3_max(center, M3_EPS);
  i = 0;
  while (i < B) (
    y = (m3_axis[i] + M3_EPS) * invc;
    y = m3_log(y) * M3_LOG2E_F;
    y = y * (-k);
    y = m3_exp(y);
    y = y + 1.0;
    y = 1.0 / y;
    y = y - 0.5;
    y = y * gain;
    y = y * M3_SHAPE_MUL;
    dst[i] = m3_exp(y);
    i += 1;
  );
);

function m3_shape_parent(dst, B, s0, s1, sa, sb) local(g0, g1, i, pa, pb) (
  g0 = log(s0) / log(10.0) * 20.0;
  g1 = log(s1) / log(10.0) * 20.0;
  m3_shape_child(sa, B, 500.0, 12.0, -g0);
  pa = pow(10, (g0 * 0.5) * 0.05);
  m3_shape_child(sb, B, 2000.0, 12.0, g1);
  pb = pow(10, (g1 * 0.5) * 0.05);
  i = 0;
  while (i < B) (
    dst[i] = sa[i] * pa * sb[i] * pb;
    i += 1;
  );
);

function m3_build_tilt(dst, B, level) local(i) (
  m3_shape_parent(dst, B, m3_tl, m3_th, m3_sh1, m3_sh2);
  i = 0;
  while (i < B) ( dst[i] = dst[i] * level; i += 1; );
);

function m3_detail_tilt_level(d) local(g, y, slope) (
  d = m3_clip01(d);
  g = exp(d * M3_LN3_F - M3_LN2_F);
  y = g - 0.5;
  y = m3_clip01(y);
  slope = log(300.0) - M3_LN8_F;
  exp(y * slope + M3_LN8_F);
);

function m3_tilt_gain(n) ( pow(10, 2.0 * m3_clip01(n) - 1.0); );

function m3_temporal_post(x, rate) local(v) (
  v = m3_max(x, M3_EPS) * (0.001 * rate);
  v = 1.0 / v;
  v = v * (-M3_LN10);
  v = m3_exp(v);
  -v + 1.0;
);

function m3_build_temporal(B, H, detail, attack, release, tc, tca, tcb, wbc, wc5, wce, wd7) local(i, hop, rate, center, slope, exponent, p, d, beta, q, at, rt, qt, wb, w5) (
  hop = H / QDIV;
  rate = CFS / hop;
  center = (m3_mode == 1) ? 250.0 : 1000.0;
  slope = (m3_mode == 1) ? 1.0 : 2.0;
  exponent = slope;
  p = slope / exponent;
  beta = pow(2, 1.0 / p) * center;
  (m3_dirty_temporal & 1) ? (
    i = 0;
    while (i < B) (
      d = (m3_axis[i] + M3_EPS) / center;
      d = m3_min(d, beta);
      d = d + 1.0;
      d = 1.0 / d;
      d = m3_max(d, 0.0);
      q = exponent * M3_SIXTH;
      d = pow(d, q);
      d = m3_min(d, 1.0);
      tc[i] = (m3_mode == 1) ? (d * 2.0) : d;
      i += 1;
    );
  );
  (m3_dirty_temporal & 2) ? (
    m3_shape_parent(tca, B, m3_atl, m3_ath, m3_sh1, m3_sh2);
    m3_shape_parent(tcb, B, m3_rtl, m3_rth, m3_sh1, m3_sh2);
  );
  at = exp((log(2008.0) - M3_LN9) * m3_clip01(attack) + M3_LN9) - 8.0;
  rt = exp((log(2003.0) - log(33.0)) * m3_clip01(release) + log(33.0)) - 3.0;
  m3_mode == 1 ? (
    qt = exp((log(50.0) - 2.3025851249694824) * m3_clip01(detail) + 2.3025851249694824);
  ) : (
    qt = pow(250.0, m3_clip01(detail));
  );
  (m3_dirty_temporal & 4) ? (
    wb = m3_temporal_post(qt, rate);
    i = 0;
    while (i < B) ( wbc[i] = wb; i += 1; );
  );
  (m3_dirty_temporal & 8) ? (
    w5 = m3_temporal_post(2.0 * qt, rate);
    i = 0;
    while (i < B) ( wc5[i] = w5; i += 1; );
  );
  (m3_dirty_temporal & 16) ? (
    i = 0;
    while (i < B) (
      wce[i] = m3_temporal_post(at * tc[i] * tca[i], rate);
      i += 1;
    );
  );
  (m3_dirty_temporal & 32) ? (
    i = 0;
    while (i < B) (
      wd7[i] = m3_temporal_post(rt * ((m3_mode == 1) ? tcb[i] : tc[i] * tcb[i]), rate);
      i += 1;
    );
  );
);

function m3_build_maps(B, H, red, expm, starts, lens) local(j, i, d0, width, vmul, fc, invfc, r, run, m, sm, inv, edge0, edge1) (
  d0 = log(M3_BAND_HZ15 / M3_BAND_HZ0) / log(2.0) / 16.0;
  j = 1;
  while (j < 15) (
    r = m3_band_tab[j - 1] * (1.0 / m3_band_tab[j + 1]);
    m3_sw[j] = log(r) / log(2.0) * 0.5 / d0;
    j += 1;
  );
  m3_sw[0] = m3_sw[1];
  m3_sw[15] = m3_sw[14];
  j = 0;
  while (j < 16) (
    width = m3_sw[j] * M3_CURVE_GAIN * M3_CURVE_WIDTH * M3_SQRT_HALF;
    vmul = -0.5 / (width * width);
    fc = m3_band_tab[j] > 0.00000011920928955078125 ? m3_band_tab[j] : 0.00000011920928955078125;
    invfc = 1.0 / fc;
    i = 0;
    while (i < B) (
      r = (m3_axis[i] + M3_EPS) * invfc;
      r = log(r) / log(2.0);
      r = r * r;
      r = r * vmul;
      r = exp(r);
      r = r * M3_GAIN;
      r = exp(r);
      m3_raw[j * m3_rowstride + i] = r - 1.0;
      i += 1;
    );
    j += 1;
  );
  run = M3_ROW_PEAK;
  i = B - 1;
  while (i >= 0) (
    m3_raw[i] > run ? ( run = m3_raw[i]; );
    m3_raw[i] = run;
    i -= 1;
  );
  run = M3_ROW_PEAK;
  i = 0;
  while (i < B) (
    m3_raw[15 * m3_rowstride + i] > run ? ( run = m3_raw[15 * m3_rowstride + i]; );
    m3_raw[15 * m3_rowstride + i] = run;
    i += 1;
  );
  j = 1;
  while (j < 15) (
    m = M3_ROW_PEAK;
    i = 0;
    while (i < B) (
      m3_raw[j * m3_rowstride + i] > m ? ( m = m3_raw[j * m3_rowstride + i]; );
      i += 1;
    );
    (m < M3_ROW_COPY) ? (
      i = 0;
      while (i < B) (
        m3_raw[j * m3_rowstride + i] = m3_raw[(j - 1) * m3_rowstride + i];
        i += 1;
      );
      m = M3_ROW_PEAK;
      i = 0;
      while (i < B) (
        m3_raw[j * m3_rowstride + i] > m ? ( m = m3_raw[j * m3_rowstride + i]; );
        i += 1;
      );
    );
    m < M3_ROW_PEAK ? ( m = M3_ROW_PEAK; );
    inv = 1.0 / m;
    i = 0;
    while (i < B) (
      m3_raw[j * m3_rowstride + i] = m3_raw[j * m3_rowstride + i] * inv;
      i += 1;
    );
    j += 1;
  );
  j = 0;
  while (j < 16) (
    edge0 = 0;
    while (edge0 < B && !(m3_raw[j * m3_rowstride + edge0] >= M3_PASS_EDGE)) ( edge0 += 1; );
    edge1 = edge0;
    while (edge1 < B && !(m3_raw[j * m3_rowstride + edge1] < M3_PASS_EDGE)) ( edge1 += 1; );
    starts[j] = edge0;
    lens[j] = edge1 - edge0;
    sm = 0;
    i = 0;
    while (i < B) ( sm += abs(m3_raw[j * m3_rowstride + i]); i += 1; );
    inv = 1.0 / sm;
    i = 0;
    while (i < B) (
      red[j * B + i] = m3_raw[j * m3_rowstride + i] * inv;
      i += 1;
    );
    j += 1;
  );
  i = 0;
  while (i < B) ( m3_part[i] = 0; i += 1; );
  j = 0;
  while (j < 16) (
    edge0 = starts[j];
    edge1 = edge0 + lens[j];
    i = edge0;
    while (i < edge1) (
      m3_part[i] = m3_part[i] + m3_raw[j * m3_rowstride + i];
      i += 1;
    );
    j += 1;
  );
  i = 0;
  while (i < B) (
    m3_part[i] < M3_PART_FLOOR ? ( m3_part[i] = M3_PART_FLOOR; );
    i += 1;
  );
  j = 0;
  while (j < 16) (
    i = 0;
    while (i < B) (
      expm[j * B + i] = m3_raw[j * m3_rowstride + i] / m3_part[i];
      i += 1;
    );
    j += 1;
  );
);

function m3_curve_helper(B, hd, he) local(i, level, c) (
  level = (1000.0 / (CFS * 0.5)) * B;
  i = 0;
  while (i < B) (
    c = (i == 0) ? level : level / i;
    hd[i] = c < 1.0 ? c : 1.0;
    he[i] = c > 1.0 ? c : 1.0;
    i += 1;
  );
);

function m3_generate_curve(B, inp, curve, scale, shape, sat, hd, he) local(i, inv, b0, bp, b1, cv, a0, b2) (
  inv = 1.0 / scale;
  i = 0;
  while (i < B) (
    b0 = he[i] * hd[i];
    bp = pow(b0, shape);
    b1 = bp * inp[i];
    cv = abs(b1) + sat;
    cv = (1.0 / cv) * sat;
    a0 = b1 * cv;
    b2 = (inv == 1.0) ? a0 : a0 * inv;
    curve[i] = exp(b2 * (-6.28318548202514648));
    i += 1;
  );
  curve[0] = 0.0;
);

function m3_build_matrix(B, f, mat) local(q, g, j, a0, a1, a2, a3, n0, n1, n2, n3, b0, b1, b2, b3, lo, hi, z) (
  q = (B - 1) / 4;
  g = 0;
  while (g < q) (
    a0 = m3_clamp_curve(f[4 * g + 0]);
    a1 = m3_clamp_curve(f[4 * g + 1]);
    a2 = m3_clamp_curve(f[4 * g + 2]);
    a3 = m3_clamp_curve(f[4 * g + 3]);
    n0 = -a0; n1 = -a1; n2 = -a2; n3 = -a3;
    b0 = 1.0 - a0; b1 = 1.0 - a1; b2 = 1.0 - a2; b3 = 1.0 - a3;
    lo = 20 * g;
    mat[lo + 0] = n0 * -1.0;
    mat[lo + 1] = n1 * n0;
    mat[lo + 2] = ((n0 * -1.0) * n1) * n2;
    mat[lo + 3] = ((n1 * n0) * n2) * n3;
    mat[lo + 4] = b0;
    mat[lo + 5] = (n1 * -1.0) * b0;
    mat[lo + 6] = (n2 * n1) * b0;
    mat[lo + 7] = (((n1 * -1.0) * n2) * n3) * b0;
    mat[lo + 8] = 0.0;
    mat[lo + 9] = b1;
    mat[lo + 10] = (n2 * -1.0) * b1;
    mat[lo + 11] = (n3 * n2) * b1;
    mat[lo + 12] = 0.0;
    mat[lo + 13] = 0.0;
    mat[lo + 14] = b2;
    mat[lo + 15] = (n3 * -1.0) * b2;
    mat[lo + 16] = 0.0;
    mat[lo + 17] = 0.0;
    mat[lo + 18] = 0.0;
    mat[lo + 19] = b3;
    hi = 20 * (2 * q - g);
    mat[hi + 0] = ((n2 * n3) * n1) * n0;
    mat[hi + 1] = ((n3 * -1.0) * n2) * n1;
    mat[hi + 2] = n2 * n3;
    mat[hi + 3] = n3 * -1.0;
    mat[hi + 4] = (((n2 * -1.0) * n1) * n0) * b3;
    mat[hi + 5] = (n1 * n2) * b3;
    mat[hi + 6] = (n2 * -1.0) * b3;
    mat[hi + 7] = b3;
    mat[hi + 8] = (n0 * n1) * b2;
    mat[hi + 9] = (n1 * -1.0) * b2;
    mat[hi + 10] = b2;
    mat[hi + 11] = 0.0;
    mat[hi + 12] = (n0 * -1.0) * b1;
    mat[hi + 13] = b1;
    mat[hi + 14] = 0.0;
    mat[hi + 15] = 0.0;
    mat[hi + 16] = b0;
    mat[hi + 17] = 0.0;
    mat[hi + 18] = 0.0;
    mat[hi + 19] = 0.0;
    g += 1;
  );
  lo = 20 * q;
  j = 0;
  while (j < 20) ( mat[lo + j] = 0.0; j += 1; );
  z = m3_clamp_curve(f[B - 1]);
  mat[lo + 0] = z;
  mat[lo + 4] = 1.0 - z;
);

function m3_build_filters(B, H, tilt, detail, m15, m20, shape) local(i, scale) (
  i = 0;
  while (i < B) (
    m3_fin[i] = 0.16 * tilt[i] + 30.0;
    i += 1;
  );
  m3_curve_helper(B, m3_fhd, m3_fhe);
  scale = (48000.0 / CFS) * B;
  m3_generate_curve(B, m3_fin, m3_fcur, scale, shape, 600.0, m3_fhd, m3_fhe);
  m3_build_matrix(B, m3_fcur, m15);
  i = 0;
  while (i < B) (
    m3_fin[i] = tilt[i] * detail[i];
    i += 1;
  );
  m3_generate_curve(B, m3_fin, m3_fcur, scale, shape, 600.0, m3_fhd, m3_fhe);
  m3_build_matrix(B, m3_fcur, m20);
);

function m3_filter(mat, n, io) local(q, g, o, x0, x1, x2, x3, carry, c) (
  q = (n - 1) / 4;
  carry = io[0];
  g = 0;
  while (g < q) (
    o = 4 * g;
    x0 = io[o];
    x1 = io[o + 1];
    x2 = io[o + 2];
    x3 = io[o + 3];
    c = 20 * g;
    io[o] = ((x0 * mat[c + 4] + carry * mat[c]) + x1 * mat[c + 8]) + (x3 * mat[c + 16] + x2 * mat[c + 12]);
    io[o + 1] = ((x0 * mat[c + 5] + carry * mat[c + 1]) + x1 * mat[c + 9]) + (x3 * mat[c + 17] + x2 * mat[c + 13]);
    io[o + 2] = ((x0 * mat[c + 6] + carry * mat[c + 2]) + x1 * mat[c + 10]) + (x3 * mat[c + 18] + x2 * mat[c + 14]);
    io[o + 3] = ((x0 * mat[c + 7] + carry * mat[c + 3]) + x1 * mat[c + 11]) + (x3 * mat[c + 19] + x2 * mat[c + 15]);
    carry = io[o + 3];
    g += 1;
  );
  c = 20 * q;
  io[n - 1] = io[n - 1] * mat[c + 4] + carry * mat[c + 0];
  carry = io[n - 1];
  g = q - 1;
  while (g >= 0) (
    o = 4 * g;
    x0 = io[o];
    x1 = io[o + 1];
    x2 = io[o + 2];
    x3 = io[o + 3];
    c = 20 * (2 * q - g);
    io[o] = ((x3 * mat[c + 4] + carry * mat[c]) + x2 * mat[c + 8]) + (x1 * mat[c + 12] + x0 * mat[c + 16]);
    io[o + 1] = ((x3 * mat[c + 5] + carry * mat[c + 1]) + x2 * mat[c + 9]) + (x1 * mat[c + 13] + x0 * mat[c + 17]);
    io[o + 2] = ((x3 * mat[c + 6] + carry * mat[c + 2]) + x2 * mat[c + 10]) + (x1 * mat[c + 14] + x0 * mat[c + 18]);
    io[o + 3] = ((x3 * mat[c + 7] + carry * mat[c + 3]) + x2 * mat[c + 11]) + (x1 * mat[c + 15] + x0 * mat[c + 19]);
    carry = io[o];
    g -= 1;
  );
);

function m3_smooth(hist, cur, wup, wdn, B) local(i, d, up, dn) (
  i = 0;
  while (i < B) (
    d = cur[i] - hist[i];
    up = d > 0 ? d : 0;
    dn = d < 0 ? d : 0;
    hist[i] = hist[i] + up * wup[i] + dn * wdn[i];
    i += 1;
  );
);

function m3_stereolink(B, pl, pr, outl, outr, amount) local(i, a, bv, sum, ratio, keep) (
  keep = 1.0 - amount;
  i = 0;
  while (i < B) (
    a = pl[i];
    bv = pr[i];
    sum = a + bv;
    sum < M3_EPS ? ( sum = M3_EPS; );
    ratio = (a * a + bv * bv) / sum;
    outl[i] = keep * a + amount * ratio;
    outr[i] = keep * bv + amount * ratio;
    i += 1;
  );
);

function m3_measure(B, hist, cv, expanded, product, red, expmap, w3, starts, lens, adapt, chist, strength) local(j, i, sm, first, second, sa, sb, coef, d, up, dn, den, ratio, p, s, e, rb, eb, lc) (
  j = 0;
  while (j < 16) (
    sm = 0;
    rb = j * B;
    s = starts[j];
    e = s + lens[j];
    i = s;
    while (i < e) (
      sm += hist[i] * red[rb + i];
      i += 1;
    );
    cv[j] = sm;
    j += 1;
  );
  first = 0; second = 0;
  j = 0;
  while (j < 16) (
    first += cv[j] * m3_kloww[j];
    second += cv[j] * m3_khighw[j];
    j += 1;
  );
  first = m3_max(first, M3_TINY);
  second = m3_max(second, M3_TINY);
  sa = (second / first) * first;
  sb = ((first / second) * second) * (1.0 - m3_detail);
  j = 0;
  while (j < 16) (
    cv[j] = cv[j] + m3_klowe[j] * sa;
    cv[j] = cv[j] + m3_khighe[j] * sb;
    j += 1;
  );
  adapt ? (
    coef = 1.0 - pow(0.10000000149011612, 1.0 / (((CFS / ((B - 1) / QDIV)) * 0.5)));
    j = 0;
    while (j < 16) (
      d = cv[j] - chist[j];
      up = d > 0 ? d : 0;
      dn = d < 0 ? d : 0;
      chist[j] = chist[j] + up * coef + dn * coef;
      j += 1;
    );
    j = 0;
    while (j < 16) (
      den = m3_max(chist[j], 0.000009999999747378752);
      ratio = cv[j] / den;
      ratio = m3_max(ratio, 1.0);
      m3_lcv[j] = ratio;
      m3_lcr[j] = ratio;
      j += 1;
    );
    p = m3_lcv[0];
    j = 0;
    while (j < 16) (
      p = p + (m3_lcv[j] - p) * 0.1;
      m3_lcv[j] = p;
      j += 1;
    );
    j = 14;
    while (j >= 0) (
      p = p + (m3_lcv[j] - p) * 0.1;
      m3_lcv[j] = p;
      j -= 1;
    );
    j = 0;
    while (j < 16) (
      m3_lcv[j] = m3_max(m3_lcv[j], 1.0);
      cv[j] = cv[j] * (m3_lcr[j] / m3_lcv[j]);
      j += 1;
    );
  );
  j = 0;
  while (j < 16) (
    cv[j] = m3_max(cv[j], 0.009999999776482582);
    m3_lc16[j] = m3_log(cv[j]);
    j += 1;
  );
  i = 0;
  while (i < B) ( expanded[i] = 0; i += 1; );
  j = 0;
  while (j < 16) (
    eb = j * B;
    lc = m3_lc16[j];
    s = starts[j];
    e = s + lens[j];
    i = s;
    while (i < e) (
      expanded[i] += expmap[eb + i] * lc;
      i += 1;
    );
    j += 1;
  );
  i = 0;
  while (i < B) (
    expanded[i] = m3_exp(-expanded[i]) * strength * w3[i];
    product[i] = hist[i] * expanded[i];
    i += 1;
  );
);

function m3_finish(B, prod, fin, out, gh, mat, w8, w478, wce, wd7, balance, cutoff) local(i, v) (
  i = 0;
  while (i < B) (
    v = prod[i] * w8[i];
    v = m3_max(v, 1.0);
    fin[i] = (-m3_log(v)) * balance;
    out[i] = m3_max(fin[i], -6.907755278982137);
    i += 1;
  );
  m3_filter(mat, B, out);
  m3_smooth(gh, out, wd7, wce, B);
  i = 0;
  while (i < B) (
    out[i] = m3_max(gh[i], cutoff);
    i += 1;
  );
  m3_filter(mat, B, out);
  i = 0;
  while (i < B) (
    out[i] = out[i] * w478[i];
    i += 1;
  );
);

function m3_build_w358(dst, bins, fsize) local(k, step, step2, x, w, u, amp, wscale) (
  step = (1.0 / bins) * (CFS * 0.5);
  step2 = CFS / fsize;
  amp = log(pow(10, 0.3));
  wscale = -0.5 / (2.0 * 0.601591280067049 * 0.7071067811865475 *
                   2.0 * 0.601591280067049 * 0.7071067811865475);
  k = 0;
  while (k < bins) (
    x = k * step * 0.001;
    w = (k * step2 + 0.00000011920928955078125) * 0.0005;
    w = w < 4000 ? w : 4000;
    w = 1 - 1 / (w + 1);
    w = w > 0 ? w : 0;
    w = sqrt(w);
    w = w < 1 ? w : 1;
    x = x * w;
    u = log((k * step2 + 0.00000011920928955078125) / 4500) * 1.4426950408889634;
    x = x * exp(exp(u * u * wscale) * amp);
    u = log((k * step2 + 0.00000011920928955078125) / 8000) * 1.4426950408889634;
    x = x * exp(exp(u * u * wscale) * amp);
    dst[k] = x;
    k += 1;
  );
);

function m3_head1(B, cur, prod, scr, m15, m20, w358, strength) local(i) (
  i = 0;
  while (i < B) (
    prod[i] = cur[i] * strength;
    scr[i] = prod[i];
    i += 1;
  );
  m3_filter(m15, B, scr);
  i = 0;
  while (i < B) (
    prod[i] = prod[i] - scr[i];
    i += 1;
  );
  m3_filter(m20, B, prod);
  i = 0;
  while (i < B) (
    prod[i] = m3_max(prod[i], 0) * w358[i];
    i += 1;
  );
);

function m3_tail1(B, prod, out, gh, mat, w8, w478, wce, wd7, balance, cutoff, gain) local(i, v) (
  i = 0;
  while (i < B) (
    v = prod[i] * w8[i];
    v = v * v + 1.0;
    out[i] = m3_max(m3_log(v) * gain, -6.907755374908447);
    i += 1;
  );
  m3_filter(mat, B, out);
  m3_smooth(gh, out, wd7, wce, B);
  i = 0;
  while (i < B) (
    out[i] = m3_max(gh[i], cutoff);
    i += 1;
  );
  m3_filter(mat, B, out);
  i = 0;
  while (i < B) (
    out[i] = (out[i] * w478[i]) * balance;
    i += 1;
  );
);

function m3_stage_small() (
  m3_smooth(m3_hm_l, m3_mf_l, m3_wbs, m3_wcs, SB);
  memcpy(m3_cur_l, m3_hm_l, SB);
  m3_smooth(m3_hm_r, m3_mf_r, m3_wbs, m3_wcs, SB);
  memcpy(m3_cur_r, m3_hm_r, SB);
  m3_mode == 1 ? (
    m3_head1(SB, m3_cur_l, m3_pr_l, m3_hsc, m3_m15s, m3_m20s, m3_w358s, m3_strength);
    m3_head1(SB, m3_cur_r, m3_pr_r, m3_hsc, m3_m15s, m3_m20s, m3_w358s, m3_strength);
    m3_stereolink(SB, m3_pr_l, m3_pr_r, m3_lk_l, m3_lk_r, m3_link_amt);
    m3_tail1(SB, m3_lk_l, m3_mm_l, m3_gh_l, m3_m20s, m3_w8sl, m3_w4s, m3_wes, m3_wds, m3_bal_l, m3_cutoff, m3_gain1);
    m3_tail1(SB, m3_lk_r, m3_mm_r, m3_gh_r, m3_m20s, m3_w8sr, m3_w4s, m3_wes, m3_wds, m3_bal_r, m3_cutoff, m3_gain1);
  ) : (
  m3_measure(SB, m3_cur_l, m3_c16_l, m3_ex_l, m3_pr_l, m3_reds, m3_exps, m3_w3s, m3_msts, m3_mlns, 0, m3_c16_l, m3_strength);
  m3_measure(SB, m3_cur_r, m3_c16_r, m3_ex_r, m3_pr_r, m3_reds, m3_exps, m3_w3s, m3_msts, m3_mlns, 0, m3_c16_r, m3_strength);
  m3_stereolink(SB, m3_pr_l, m3_pr_r, m3_lk_l, m3_lk_r, m3_link_amt);
  m3_finish(SB, m3_lk_l, m3_fn_l, m3_mm_l, m3_gh_l, m3_m20s, m3_w8sl, m3_w4s, m3_wes, m3_wds, m3_bal_l, m3_cutoff);
  m3_finish(SB, m3_lk_r, m3_fn_r, m3_mm_r, m3_gh_r, m3_m20s, m3_w8sr, m3_w4s, m3_wes, m3_wds, m3_bal_r, m3_cutoff);
  );
);

function m3_stage_primary() (
  m3_smooth(m3_hmr_l, m3_mfp_l, m3_wbp, m3_wcp, PB);
  memcpy(m3_curp_l, m3_hmr_l, PB);
  m3_smooth(m3_hmr_r, m3_mfp_r, m3_wbp, m3_wcp, PB);
  memcpy(m3_curp_r, m3_hmr_r, PB);
  m3_mode == 1 ? (
    m3_head1(PB, m3_curp_l, m3_prp_l, m3_hsc, m3_m15p, m3_m20p, m3_w358p, m3_strength);
    m3_head1(PB, m3_curp_r, m3_prp_r, m3_hsc, m3_m15p, m3_m20p, m3_w358p, m3_strength);
    m3_stereolink(PB, m3_prp_l, m3_prp_r, m3_lkp_l, m3_lkp_r, m3_link_amt);
    m3_tail1(PB, m3_lkp_l, m3_mmp_l, m3_ghp_l, m3_m20p, m3_w8pl, m3_w4p, m3_wep, m3_wdp, m3_bal_l, m3_cutoff, m3_gain1);
    m3_tail1(PB, m3_lkp_r, m3_mmp_r, m3_ghp_r, m3_m20p, m3_w8pr, m3_w4p, m3_wep, m3_wdp, m3_bal_r, m3_cutoff, m3_gain1);
  ) : (
  m3_measure(PB, m3_curp_l, m3_c16pl, m3_exp_l, m3_prp_l, m3_redp, m3_expp, m3_w3p, m3_mstp, m3_mlnp, 1, m3_c16h_l, m3_strength);
  m3_measure(PB, m3_curp_r, m3_c16pr, m3_exp_r, m3_prp_r, m3_redp, m3_expp, m3_w3p, m3_mstp, m3_mlnp, 1, m3_c16h_r, m3_strength);
  m3_stereolink(PB, m3_prp_l, m3_prp_r, m3_lkp_l, m3_lkp_r, m3_link_amt);
  m3_finish(PB, m3_lkp_l, m3_fnp_l, m3_mmp_l, m3_ghp_l, m3_m20p, m3_w8pl, m3_w4p, m3_wep, m3_wdp, m3_bal_l, m3_cutoff);
  m3_finish(PB, m3_lkp_r, m3_fnp_r, m3_mmp_r, m3_ghp_r, m3_m20p, m3_w8pr, m3_w4p, m3_wep, m3_wdp, m3_bal_r, m3_cutoff);
  );
);

function m3_asinh(x) ( log(x + sqrt(x * x + 1.0)); );

function m3_band_q(n) local(t, plain, p, twice) (
  t = m3_clip01(n);
  plain = exp(log(0.1) + pow(t, 1.2354510124930291) * (log(10.0) - log(0.1)));
  p = plain;
  (!(p > 0)) ? ( 0; ) : (
    twice = 2.0 * p;
    m3_asinh(1.0 / twice) * 2.8853900817779268;
  );
);

function m3_shape_bell(x) local(s) (
  s = m3_round(m3_clip01(x) * 7.0);
  (s == 2) || (s == 3);
);

function m3_set_bands() local(i) (
  m3_bu[0]=slider20>=0.5; m3_be[0]=slider21>=0.5;
  m3_bf[0]=170*exp(m3_clip01(slider22)*log(118.52941176470588))-150;
  m3_bd[0]=24*m3_clip01(slider23)-12; m3_bq[0]=m3_band_q(m3_clip01(slider24));
  m3_bs[0]=exp((log(128.0)-1.7917594909667969)*m3_clip01(slider25)+1.7917594909667969);
  m3_bfo[0]=m3_clip01(slider26); m3_bsh[0]=m3_round(m3_clip01(slider28)*7);
  m3_bu[1]=slider29>=0.5; m3_be[1]=slider30>=0.5;
  m3_bf[1]=170*exp(m3_clip01(slider31)*log(118.52941176470588))-150;
  m3_bd[1]=24*m3_clip01(slider32)-12; m3_bq[1]=m3_band_q(m3_clip01(slider33));
  m3_bs[1]=exp((log(128.0)-1.7917594909667969)*m3_clip01(slider34)+1.7917594909667969);
  m3_bfo[1]=m3_clip01(slider35); m3_bsh[1]=m3_round(m3_clip01(slider37)*7);
  m3_bu[2]=slider38>=0.5; m3_be[2]=slider39>=0.5;
  m3_bf[2]=170*exp(m3_clip01(slider40)*log(118.52941176470588))-150;
  m3_bd[2]=24*m3_clip01(slider41)-12; m3_bq[2]=m3_band_q(m3_clip01(slider42));
  m3_bs[2]=exp((log(128.0)-1.7917594909667969)*m3_clip01(slider43)+1.7917594909667969);
  m3_bfo[2]=m3_clip01(slider44); m3_bsh[2]=m3_round(m3_clip01(slider46)*7);
  m3_bu[3]=slider47>=0.5; m3_be[3]=slider48>=0.5;
  m3_bf[3]=170*exp(m3_clip01(slider49)*log(118.52941176470588))-150;
  m3_bd[3]=24*m3_clip01(slider50)-12; m3_bq[3]=m3_band_q(m3_clip01(slider51));
  m3_bs[3]=exp((log(128.0)-1.7917594909667969)*m3_clip01(slider52)+1.7917594909667969);
  m3_bfo[3]=m3_clip01(slider53); m3_bsh[3]=m3_round(m3_clip01(slider55)*7);
  m3_bu[4]=slider56>=0.5; m3_be[4]=slider57>=0.5;
  m3_bf[4]=170*exp(m3_clip01(slider58)*log(118.52941176470588))-150;
  m3_bd[4]=24*m3_clip01(slider59)-12; m3_bq[4]=m3_band_q(m3_clip01(slider60));
  m3_bs[4]=exp((log(128.0)-1.7917594909667969)*m3_clip01(slider61)+1.7917594909667969);
  m3_bfo[4]=m3_clip01(slider62); m3_bsh[4]=m3_round(m3_clip01(slider64)*7);
  m3_bu[5]=slider65>=0.5; m3_be[5]=slider66>=0.5;
  m3_bf[5]=170*exp(m3_clip01(slider67)*log(118.52941176470588))-150;
  m3_bd[5]=24*m3_clip01(slider68)-12; m3_bq[5]=m3_band_q(m3_clip01(slider69));
  m3_bs[5]=exp((log(128.0)-1.7917594909667969)*m3_clip01(slider70)+1.7917594909667969);
  m3_bfo[5]=m3_clip01(slider71); m3_bsh[5]=m3_round(m3_clip01(slider73)*7);
  m3_bu[6]=slider74>=0.5; m3_be[6]=slider75>=0.5;
  m3_bf[6]=170*exp(m3_clip01(slider76)*log(118.52941176470588))-150;
  m3_bd[6]=24*m3_clip01(slider77)-12; m3_bq[6]=m3_band_q(m3_clip01(slider78));
  m3_bs[6]=exp((log(128.0)-1.7917594909667969)*m3_clip01(slider79)+1.7917594909667969);
  m3_bfo[6]=m3_clip01(slider80); m3_bsh[6]=m3_round(m3_clip01(slider82)*7);
  m3_bu[7]=slider83>=0.5; m3_be[7]=slider84>=0.5;
  m3_bf[7]=170*exp(m3_clip01(slider85)*log(118.52941176470588))-150;
  m3_bd[7]=24*m3_clip01(slider86)-12; m3_bq[7]=m3_band_q(m3_clip01(slider87));
  m3_bs[7]=exp((log(128.0)-1.7917594909667969)*m3_clip01(slider88)+1.7917594909667969);
  m3_bfo[7]=m3_clip01(slider89); m3_bsh[7]=m3_round(m3_clip01(slider91)*7);
);

function m3_detail_shape(d) local(x) (
  x = d - 0.5;
  x < 0 ? ( x = 0; );
  x = x * 2.0;
  x < 0 ? ( x = 0; );
  x > 1 ? ( x = 1; );
  x = x * 0.5;
  0.6 - x;
);

function m3_apply_detail(sel, det, B, small) local(i, r) (
  i = 0;
  while (i < B) (
    (det[i] != 1.0) ? (
      r = 1.0 / det[i];
      small ? ( sel[i] = sel[i] * r; ) : ( sel[i] = sel[i] + (1.0 - sel[i]) * (1.0 - r); );
    );
    i += 1;
  );
);

function m3_calc_strength(D, Q) local(t) (
  t = 2.0 - Q * Q + M3_THIRD;
  t = log(t) + M3_CUT_MUL;
  t = t * m3_clip01(D);
  t = t - M3_CUT_MUL;
  exp(t) - M3_THIRD;
);

function m3_calc_strength1(D, Q) local(gt, gu, ga, gx, gb, gc) (
  gt = (D - 0.800000011920929) * 5.000000476837158;
  gt = gt < 0 ? 0 : (gt > 1 ? 1 : gt);
  gu = (1 - Q * 0.5) * gt;
  gu = gu < 0 ? 0 : (gu > 1 ? 1 : gu);
  ga = exp(gu * 1.3862943649291992);
  gx = log(pow(10, 2.4000000953674316) + 0.10000000149011612) + 2.3025851249694824;
  gx = gx * m3_clip01(D) - 2.3025851249694824;
  gb = exp(gx) - 0.10000000149011612;
  gc = pow(10, m3_clip01(Q * Q) * -24.0 * 0.05000000074505806);
  ga * (gb * gc);
);

