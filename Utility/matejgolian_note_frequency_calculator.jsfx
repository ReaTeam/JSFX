desc: Note Frequency Calculator
author: Matej Golian
version: 1.0
changelog: Initial release
about:
  # Note Frequency Calculator

  Calculate note frequencies based on manual entry or MIDI note input.

  ## Usage
  Add the plugin to your track and determine individual note frequencies. Calculations are performed based on the A4 note, which can be set anywhere between 360 and 530 Hz. You can apply fine tuning, input notes using MIDI and play the resulting frequency back via a simple tone generator.

// 1. Hardware Controls (Sliders)
slider1:440<360,530,1>Base Frequency A4 (Hz)
slider2:9<0,11,1{C,C#,D,D#,E,F,F#,G,G#,A,A#,B}>Note
slider3:0<-5,5,1>Octave
slider4:0<-100,100,0.01>Fine Tune (cents)
slider5:440<2,20000,0.1>Resulting Frequency (Hz)
slider6:1<0,2,1{57 (A4 = Note #57),69 (A4 = Note #69),81 (A4 = Note #81)}>MIDI Note for A4
slider7:2<0,2,1{Off,Always,On MIDI input}>Waveform Playback
slider8:0<0,2,1{Sine,Triangle,Saw}>Waveform Shape
slider9:-12<-120,6,0.1>Waveform Volume (dB)

@init
// Numeric-only initialization variables to prevent memory corruption
result_freq = 440;
phase = 0;

// Internal tracker for active MIDI notes
midi_note_count = 0;

// Allocate memory block array for tracking 128 MIDI keys (0-127)
note_array = 0; 

// FIXED AUDIO ATTENUATOR OFFSET (Change as needed)
volume_offset = -12;

// Safety memory bank for value restoration on invalid text input
last_base = 440;
last_note = 9;
last_octave = 0;
last_fine = 0;
last_result = 440;
last_volume = -12;
last_waveform = 0;
last_a4_ref = 1; // Matches the true default state definition

// Directional state flag: 0 = calculate down from notes, 1 = manual override active
override_active = 0;

// Mathematical constants
LN2 = 0.6931471805599453;
PI2 = 6.283185307179586;

// Function to resolve what MIDI note number maps to A4 based on listbox selection
function get_a4_midi_reference() (
  slider6 == 0 ? 57 : slider6 == 2 ? 81 : 69;
);

// Function to scan memory array and update engine to the first active note found
function trigger_first_active_note() local(i, found, m_note, m_semitones, abs_note, a4_ref, total_calc_semitones) (
  i = 0;
  found = 0;
  while (i < 128 && found == 0) (
    note_array[i] == 1 ? (
      m_note = i;
      found = 1;
    );
    i += 1;
  );

  found ? (
    a4_ref = get_a4_midi_reference();
    m_semitones = m_note - a4_ref;
    
    total_calc_semitones = m_semitones + (slider4 / 100);
    
    result_freq = slider1 * pow(2, total_calc_semitones / 12);
    slider5 = result_freq;
    
    // Map absolute display note based on reference (A4 is always Absolute 57 internally for UI mapping)
    abs_note = m_semitones + 57;
    slider3 = floor(abs_note / 12) - 4;
    slider2 = abs_note - ((slider3 + 4) * 12);
    
    slider3 < -5 ? (slider3 = -5; slider2 = 0;) : slider3 > 5 ? (slider3 = 5; slider2 = 11;);
    
    last_note = slider2;
    last_octave = slider3;
    last_fine = slider4;
    last_result = slider5;
    override_active = 0;
  );
);

// PolyBLEP helper function for clean anti-aliased waveforms
function poly_blep(t, dt) (
  t < dt ? (
    t /= dt;
    2.0 * t - t * t - 1.0;
  ) : t > (1.0 - dt) ? (
    t = (t - 1.0) / dt;
    t * t + 2.0 * t + 1.0;
  ) : 0.0;
);

@slider
// ========================================================
// STEP 1: NATIVE INPUT VALIDATION (REAPER NaN OCHRANA)
// ========================================================
slider1 != slider1 || slider1 < 360 ? slider1 = last_base;
slider2 != slider2 ? slider2 = last_note;
slider3 != slider3 ? slider3 = last_octave;
slider4 != slider4 ? slider4 = last_fine;
slider5 != slider5 || slider5 < 2 ? slider5 = last_result;
slider6 != slider6 ? slider6 = last_a4_ref;
slider9 != slider9 ? slider9 = last_volume;

// Enforce boundary limits during manual text editing
slider1 < 360 ? slider1 = 360 : slider1 > 530 ? slider1 = 530;
slider3 = floor(slider3);
slider3 < -5 ? slider3 = -5 : slider3 > 5 ? slider3 = 5;
slider4 < -100 ? slider4 = -100 : slider4 > 100 ? slider4 = 100;
slider9 < -120 ? slider9 = -120 : slider9 > 6 ? slider9 = 6;

// --- FIXED VOLUME CALCULATION WITH PERMANENT OFFSET ---
slider9 <= -120 ? (
  gain = 0;
) : (
  actual_db = slider9 + volume_offset;
  gain = pow(10, actual_db / 20);
);

// ========================================================
// STEP 2: DYNAMIC OVERRIDE DETECTION & SYNCHRONIZATION
// ========================================================
(slider1 != last_base || slider2 != last_note || slider3 != last_octave || slider4 != last_fine) ? (
  override_active = 0;
);

slider5 != last_result ? (
  override_active = 1;
);

override_active == 1 ? (
  slider5 < 2 ? slider5 = 2 : slider5 > 20000 ? slider5 = 20000;

  // Calculate total exact log semitones from reference frequency
  exact_semitones = 12 * (log(slider5 / slider1) / LN2);
  
  // Round to the closest integer semitone for note/octave assignment
  total_semitones = floor(exact_semitones + 0.5);
  
  // The fractional remainder represents the deviation in Cents
  slider4 = (exact_semitones - total_semitones) * 100;
  
  absolute_note = total_semitones + 9;
  slider3 = floor(absolute_note / 12);
  slider2 = absolute_note - (slider3 * 12);
  
  slider3 < -5 ? (slider3 = -5; slider2 = 0;) : slider3 > 5 ? (slider3 = 5; slider2 = 11;);
  
  result_freq = slider5;
) : (
  // Downward direction: Mapping note + octave + fine tune cents directly to Hz
  note_diff = slider2 - 9;
  calc_semitones = note_diff + (slider3 * 12);
  
  // Include fine tune cents as fractional parts of a semitone
  total_calc_semitones = calc_semitones + (slider4 / 100);
  
  result_freq = slider1 * pow(2, total_calc_semitones / 12);
  slider5 = result_freq; 
);

last_base = slider1;
last_note = slider2;
last_octave = slider3;
last_fine = slider4;
last_result = slider5;
last_a4_ref = slider6;
last_volume = slider9;

slider8 != last_waveform ? (
  phase = 0;
  last_waveform = slider8;
);

@block
// ========================================================
// STEP 3: MIDI INPUT PROCESSING WITH NOTE SCANNER
// ========================================================
a4_midi_base = get_a4_midi_reference();

while (midirecv(offset, msg1, msg2, msg3)) (
  status = msg1 & $xF0;
  
  // Note On event
  status == $x90 ? (
    msg3 > 0 ? (
      midi_note = msg2;
      
      note_array[midi_note] == 0 ? (
        note_array[midi_note] = 1;
        midi_note_count += 1;
      );
      
      // Calculate distance based on dynamically loaded A4 reference number
      midi_semitones = midi_note - a4_midi_base;
      
      total_calc_semitones = midi_semitones + (slider4 / 100);
      
      result_freq = slider1 * pow(2, total_calc_semitones / 12);
      slider5 = result_freq;
      
      absolute_note = midi_semitones + 57;
      slider3 = floor(absolute_note / 12) - 4; 
      slider2 = absolute_note - ((slider3 + 4) * 12);
      
      slider3 < -5 ? (slider3 = -5; slider2 = 0;) : slider3 > 5 ? (slider3 = 5; slider2 = 11;);
      
      last_note = slider2;
      last_octave = slider3;
      last_fine = slider4;
      last_result = slider5;
      override_active = 0; 
    ) : (
      // Note On with velocity 0 is treated as Note Off
      midi_note = msg2;
      note_array[midi_note] == 1 ? (
        note_array[midi_note] = 0;
        midi_note_count -= 1;
        midi_note_count < 0 ? midi_note_count = 0;
        
        midi_note_count > 0 ? trigger_first_active_note();
      );
    );
  );
  
  // Standard Note Off event
  status == $x80 ? (
    midi_note = msg2;
    note_array[midi_note] == 1 ? (
      note_array[midi_note] = 0;
      midi_note_count -= 1;
      midi_note_count < 0 ? midi_note_count = 0;
      
      midi_note_count > 0 ? trigger_first_active_note();
    );
  );
  
  midisend(offset, msg1, msg2, msg3);
);

@sample
// ========================================================
// STEP 4: AUDIO SYNTHESIS
// ========================================================
osc_sample = 0;

play_gate = (slider7 == 1) || (slider7 == 2 && midi_note_count > 0);

play_gate ? (
  phase_incr = result_freq / srate;
  
  slider8 == 0 ? (
    osc_sample = sin(phase * PI2);
  ) : 
  slider8 == 1 ? (
    osc_sample = 1.0 - 4.0 * abs(floor(phase + 0.25) - (phase - 0.25));
  ) : 
  slider8 == 2 ? (
    osc_sample = 2.0 * phase - 1.0;
    osc_sample -= poly_blep(phase, phase_incr);
  );

  phase += phase_incr;
  phase >= 1.0 ? phase -= 1.0;
) : (
  phase = 0;
);

spl0 += osc_sample * gain;
spl1 += osc_sample * gain;
